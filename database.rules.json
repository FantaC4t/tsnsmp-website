{
  "rules": {
    "members": {
      ".read": true,
      ".write": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()"
    },
    "authorizedEmails": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true && root.child('pendingAdminEmails').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).val() === true"
      }
    },
    "pendingAdminEmails": {
      ".read": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()",
      "$key": {
        ".read": "auth != null && $key === auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')",
        ".write": "auth != null && (root.child('authorizedEmails').child(auth.uid).exists() || ($key === auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',') && data.val() === true && newData.val() === null))"
      }
    },
    "gallery": {
      ".read": true,
      ".write": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()"
    },
    "gallery_queue": {
      ".read": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()",
      ".write": true
    },
    "events": {
      ".read": true,
      ".write": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()"
    },
    "worldDownloads": {
      ".read": true,
      ".write": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()"
    },
    "staffApplications": {
      ".read": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()",
      ".write": true
    },
    "config": {
      ".read": true,
      ".write": "auth != null && root.child('authorizedEmails').child(auth.uid).exists()"
    }
  }
}
