    const ROLE_ORDER = ['staff', 'trialstaff', 'member', 'imposter'];

    function renderTable() {
        const countEl = document.getElementById('member-count-inline');
        if (countEl) countEl.textContent = `${membersCache.length} members`;

        if (membersCache.length === 0) {
            document.getElementById('members-container').innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No members yet</p><p class="empty-state-desc">Use the form above to add the first one.</p></div>';
            return;
        }

        const sorted = [...membersCache].sort((a, b) => {
            let ar = (a.role || '').toLowerCase();
            let br = (b.role || '').toLowerCase();
            if (ar === 'owner') ar = 'staff';
            if (ar === 'mod' || ar === 'admin') ar = 'trialstaff';
            if (br === 'owner') br = 'staff';
            if (br === 'mod' || br === 'admin') br = 'trialstaff';
            const ai = ROLE_ORDER.indexOf(ar);
            const bi = ROLE_ORDER.indexOf(br);
            return (ai === -1 ? ROLE_ORDER.length : ai) - (bi === -1 ? ROLE_ORDER.length : bi);
        });

        const rows = sorted.map((m, i) => {
            const realIdx = membersCache.findIndex(c => c === m);
            const safeName = esc(m.name);
            const safePronouns = esc(m.pronouns || '—');
            const safeTwitch = m.twitch ? `<a href="${esc(m.twitch)}" target="_blank" rel="noopener noreferrer" style="color:#9146FF">${esc(m.twitch.replace('https://www.twitch.tv/',''))}</a>` : '—';
