---
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';
---

<Layout
    title="TSNSMP Admin"
    description="TSNSMP admin panel — members management."
    path="/admin/"
    currentPage="admin"
    robots="noindex, nofollow"
>

<!-- ── LOGIN GATE ── -->
<div id="login-gate">
    <div class="login-box">
        <a class="login-back" href="/">← Back to site</a>
        <img class="login-mascot" src="/assets/mascot.png" alt="" width="90" height="68" />
        <h1>🔐 TSNSMP Admin</h1>
        <p>Members management — authorised access only</p>
        <div class="login-error" id="login-error">Access denied.</div>
        <button type="button" class="btn-google" onclick="loginWithGoogle()">
            <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Continue with Google
        </button>
        <span class="page-fold" aria-hidden="true"></span>
    </div>
</div>

<!-- ── ADMIN PANEL ── -->
<div id="admin-panel">
    <div class="admin-hero">
        <div class="admin-hero-bg"></div>
        <div class="admin-hero-grid"></div>
        <div class="admin-hero-content">
            <h1 class="admin-hero-title">🛠️ TSNSMP Admin</h1>
            <div class="admin-hero-meta">
                <span class="admin-member-count" id="member-count"></span>
                <div class="admin-user" id="admin-user" style="display:none">
                    <img class="admin-user-avatar" id="admin-user-avatar" src="" alt="">
                    <span id="admin-user-name"></span>
                </div>
                <button type="button" class="btn btn-ghost" onclick="logout()">Log out</button>
            </div>
        </div>
    </div>

    <!-- Tab bar -->
    <div class="admin-tabs">
        <button type="button" class="admin-tab-btn active" data-tab="players" onclick="switchTab('players')">👥 Player List</button>
        <button type="button" class="admin-tab-btn" data-tab="gallery" onclick="switchTab('gallery')">🖼️ Gallery</button>
        <button type="button" class="admin-tab-btn" data-tab="events" onclick="switchTab('events')">📅 Events</button>
        <button type="button" class="admin-tab-btn" data-tab="downloads" onclick="switchTab('downloads')">📥 World Downloads</button>
        <button type="button" class="admin-tab-btn" data-tab="applications" onclick="switchTab('applications')">📋 Staff Applications</button>
    </div>

    <div class="admin-body">

        <!-- ══ PLAYER LIST TAB ══ -->
        <div id="tab-players">

        <!-- Stat cards -->
        <div class="admin-stats" id="admin-stats"></div>

        <!-- Seed banner — only shown when members.json is empty -->
        <div class="seed-banner" id="seed-banner" style="display:none">
            <p>⚡ No members found. Click to load the default member list.</p>
            <button type="button" class="btn btn-primary" onclick="seedMembers()">Load Default Members</button>
        </div>

        <!-- Add member -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon green">➕</span>
                <h2>Add Member</h2>
            </div>
            <div class="panel-body">
                <div class="add-form-layout">
                    <div class="skin-preview-wrap">
                        <img class="skin-preview-img" id="skin-preview" src="https://minotar.net/armor/body/Steve/60.png" alt="Skin preview">
                        <span class="skin-preview-name" id="skin-preview-name" style="color: #7B68EE">Preview</span>
                    </div>
                    <div class="form-fields">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Minecraft Username *</label>
                                <input type="text" id="add-name" placeholder="e.g. FantaC4t"
                                    oninput="updatePreview()" />
                            </div>
                            <div class="form-group">
                                <label>Role *</label>
                                <select id="add-role">
                                    <option value="member">Member</option>
                                    <option value="trialstaff">Trial Staff</option>
                                    <option value="staff">Staff</option>
                                    <option value="imposter">Imposter</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Pronouns</label>
                                <input type="text" id="add-pronouns" placeholder="e.g. they/them" />
                            </div>
                            <div class="form-group">
                                <label>Name Color</label>
                                <div class="color-row">
                                    <input type="color" id="add-color-pick" value="#7B68EE"
                                        oninput="document.getElementById('add-color-text').value=this.value; updatePreview()" />
                                    <input type="text" id="add-color-text" placeholder="#7B68EE"
                                        oninput="document.getElementById('add-color-pick').value=this.value||'#7B68EE'; updatePreview()" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Twitch URL</label>
                                <input type="text" id="add-twitch" placeholder="https://twitch.tv/..." />
                            </div>
                        </div>
                        <button type="button" class="btn btn-green" onclick="addMember()">➕ Add to Roster</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Current members -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon purple">👥</span>
                <h2>Current Members</h2>
                <span style="font-size:.8rem;color:var(--muted)" id="member-count-inline"></span>
            </div>
            <div class="member-search-wrap">
                <div class="search-icon-wrap">
                    <input class="member-search" id="member-search" type="text" placeholder="Search members…" oninput="filterMembers()">
                </div>
                <div class="role-filter-pills" id="role-filters">
                    <button type="button" class="role-filter-pill active" data-role="all" onclick="setRoleFilter('all')">All</button>
                    <button type="button" class="role-filter-pill" data-role="staff" onclick="setRoleFilter('staff')">Staff</button>
                    <button type="button" class="role-filter-pill" data-role="trialstaff" onclick="setRoleFilter('trialstaff')">Trial Staff</button>
                    <button type="button" class="role-filter-pill" data-role="member" onclick="setRoleFilter('member')">Member</button>
                </div>
            </div>
            <div class="table-scroll" id="members-container">
                <div class="loading">Loading members…</div>
            </div>
        </div>

        </div><!-- /tab-players -->

        <!-- ══ GALLERY TAB ══ -->
        <div id="tab-gallery" style="display:none">

        <!-- Submission Queue -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon yellow">📥</span>
                <h2>Submission Queue</h2>
                <span id="queue-count"></span>
            </div>
            <div class="panel-body">
                <div class="gallery-admin-grid" id="queue-admin-grid">
                    <div class="loading">Loading queue…</div>
                </div>
            </div>
        </div>

        <!-- Gallery management -->
        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon teal">🖼️</span>
                <h2>Gallery</h2>
            </div>
            <div class="panel-body">
                <div id="gallery-drop-zone" class="gallery-file-drop"
                     onclick="document.getElementById('gallery-file').click()"
                     ondragover="event.preventDefault();this.classList.add('drag-over')"
                     ondragleave="this.classList.remove('drag-over')"
                     ondrop="event.preventDefault();this.classList.remove('drag-over');handleGalleryDrop(event)">
                    <div class="gallery-drop-icon">📸</div>
                    <p>Drop an image here or click to browse</p>
                    <span>PNG, JPG, GIF, WebP — max 10 MB</span>
                    <input type="file" id="gallery-file" accept="image/*" style="display:none" onchange="onGalleryFileSelect(this)">
                </div>
                <div class="gallery-file-preview" id="gallery-file-preview" style="display:none">
                    <img id="gallery-preview-img" src="" alt="Preview">
                    <button type="button" class="gallery-clear-btn" onclick="clearGalleryFile()">✕</button>
                </div>
                <div class="form-grid" style="margin-top:1rem">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" id="gallery-title" placeholder="e.g. Sunset at spawn">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" id="gallery-desc" placeholder="e.g. Taken by Nightshade_Stars">
                    </div>
                    <div class="form-group">
                        <label>Season</label>
                        <select id="gallery-season">
                            <option value="">&mdash; Not tagged</option>
                            <option value="1">&#127807; Season 1</option>
                            <option value="2">&#9728;&#65039; Season 2</option>
                            <option value="3">&#128640; Season 3</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Uploaded by</label>
                        <select id="gallery-uploader">
                            <option value="">&mdash; Unknown</option>
                        </select>
                    </div>
                </div>
                <div class="gallery-progress-wrap" id="gallery-progress-wrap" style="display:none">
                    <div class="gallery-progress-bar" id="gallery-progress-bar"></div>
                </div>
                <button type="button" class="btn btn-primary" onclick="uploadGalleryImage()" style="margin-top:1rem">📤 Upload Image</button>

                <h3 style="margin:2rem 0 .75rem;font-size:.9rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em">Existing Images</h3>
                <div class="gallery-admin-grid" id="gallery-admin-grid">
                    <div class="loading">Loading gallery…</div>
                </div>
            </div>
        </div>

        </div><!-- /tab-gallery -->

        <!-- ══ EVENTS TAB ══ -->
        <div id="tab-events" style="display:none">

        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon" style="background:rgba(255,152,0,.15)">📅</span>
                <h2>Add Event</h2>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Event Name *</label>
                        <input type="text" id="event-label" placeholder="e.g. Build Contest 🏗️" />
                    </div>
                    <div class="form-group">
                        <label>Start Date *</label>
                        <input type="date" id="event-date" />
                    </div>
                    <div class="form-group">
                        <label>End Date</label>
                        <input type="date" id="event-end-date" />
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" id="event-desc" placeholder="Short description" />
                    </div>
                    <div class="form-group">
                        <label>Status</label>
                        <select id="event-status">
                            <option value="auto">Auto-detect</option>
                            <option value="active">Active (highlighted)</option>
                            <option value="upcoming">Upcoming</option>
                            <option value="past">Past</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-green" onclick="addEvent()" style="margin-top:1rem">📅 Add Event</button>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon" style="background:rgba(255,152,0,.15)">📋</span>
                <h2>Current Events</h2>
                <span id="event-count" style="color:var(--muted);font-size:.85rem"></span>
            </div>
            <div class="panel-body">
                <div id="events-admin-list">
                    <div class="loading">Loading events…</div>
                </div>
            </div>
        </div>

        </div><!-- /tab-events -->

        <!-- ══ WORLD DOWNLOADS TAB ══ -->
        <div id="tab-downloads" style="display:none">

        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon" style="background:rgba(var(--s3-teal-rgb),.15)">📥</span>
                <h2>Add World Download</h2>
            </div>
            <div class="panel-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Title *</label>
                        <input type="text" id="dl-title" placeholder="e.g. Season 2 World" />
                    </div>
                    <div class="form-group">
                        <label>Download URL *</label>
                        <input type="url" id="dl-url" placeholder="https://drive.google.com/..." />
                    </div>
                </div>
                <button type="button" class="btn btn-green" onclick="addDownload()" style="margin-top:1rem">📥 Add Download</button>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon" style="background:rgba(var(--s3-teal-rgb),.15)">📋</span>
                <h2>Current Downloads</h2>
                <span id="dl-count" style="color:var(--muted);font-size:.85rem"></span>
            </div>
            <div class="panel-body">
                <div id="downloads-admin-list">
                    <div class="loading">Loading downloads…</div>
                </div>
            </div>
        </div>

        </div><!-- /tab-downloads -->

        <!-- ══ STAFF APPLICATIONS TAB ══ -->
        <div id="tab-applications" style="display:none">

        <div class="panel">
            <div class="panel-header">
                <span class="panel-header-icon" style="background:#e9d5ff">📋</span>
                <h2>Staff Applications</h2>
                <span id="app-count" style="color:var(--muted);font-size:.85rem"></span>
            </div>
            <div class="panel-body" style="padding-bottom:0">
                <div class="admin-stats" id="app-stats"><div class="loading" style="padding:.4rem 0">Loading stats…</div></div>
            </div>
            <div class="app-filter-bar">
                <input class="member-search" id="app-search" type="text" placeholder="Search Discord/Minecraft username…" oninput="renderApplicationsAdmin()">
                <div class="app-filter-pills" id="app-status-filters">
                    <button type="button" class="app-filter-pill active" data-status="all" onclick="setAppStatusFilter('all')">All</button>
                    <button type="button" class="app-filter-pill" data-status="pending" onclick="setAppStatusFilter('pending')">⏳ Pending</button>
                    <button type="button" class="app-filter-pill" data-status="accepted" onclick="setAppStatusFilter('accepted')">✅ Accepted</button>
                    <button type="button" class="app-filter-pill" data-status="rejected" onclick="setAppStatusFilter('rejected')">❌ Rejected</button>
                </div>
                <div class="app-filter-pills" id="app-role-filters">
                    <button type="button" class="app-filter-pill active" data-role="all" onclick="setAppRoleFilter('all')">All Roles</button>
                    <button type="button" class="app-filter-pill" data-role="social" onclick="setAppRoleFilter('social')">🎥 Social</button>
                    <button type="button" class="app-filter-pill" data-role="community" onclick="setAppRoleFilter('community')">💬 Community</button>
                    <button type="button" class="app-filter-pill" data-role="events" onclick="setAppRoleFilter('events')">🎪 Events</button>
                </div>
                <select class="app-sort-select" id="app-sort" onchange="renderApplicationsAdmin()">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="rating-high">Highest rated</option>
                    <option value="rating-low">Lowest rated</option>
                </select>
            </div>
            <div class="app-list" id="app-list">
                <div class="loading">Loading applications…</div>
            </div>
        </div>

        </div><!-- /tab-applications -->

    </div>
</div>

<div id="toast"></div>

<!-- Confirmation Modal -->
<div id="confirm-modal" class="confirm-backdrop" onclick="if(event.target===this)closeConfirm()">
    <div class="confirm-box">
        <h3 id="confirm-title">Are you sure?</h3>
        <p id="confirm-message">This action cannot be undone.</p>
        <div class="confirm-actions">
            <button type="button" class="btn btn-danger" id="confirm-yes">Confirm</button>
            <button type="button" class="btn btn-ghost" onclick="closeConfirm()">Cancel</button>
        </div>
    </div>
</div>

<!-- Gallery Edit Modal -->
<div id="gedit-modal" class="gedit-backdrop" onclick="if(event.target===this)closeGalleryEdit()">
    <div class="gedit-box">
        <h3>✏️ Edit Image</h3>
        <img id="gedit-preview" src="" alt="">
        <div class="gedit-field">
            <label>Title</label>
            <input type="text" id="gedit-title" maxlength="80">
        </div>
        <div class="gedit-field">
            <label>Description</label>
            <input type="text" id="gedit-desc" maxlength="160">
        </div>
        <div class="gedit-field">
            <label>Uploaded by</label>
            <select id="gedit-by">
                <option value="">&mdash; Unknown</option>
            </select>
        </div>
        <div class="gedit-field">
            <label>Season</label>
            <select id="gedit-season">
                <option value="">&mdash; Not tagged</option>
                <option value="1">&#127807; Season 1</option>
                <option value="2">&#9728;&#65039; Season 2</option>
                <option value="3">&#128640; Season 3</option>
            </select>
        </div>
        <div class="gedit-actions">
            <button type="button" class="btn btn-green" onclick="saveGalleryEdit()">💾 Save</button>
            <button type="button" class="btn btn-ghost" onclick="closeGalleryEdit()">Cancel</button>
        </div>
    </div>
</div>

<!-- Event Edit Modal -->
<div id="eedit-modal" class="eedit-backdrop" onclick="if(event.target===this)closeEventEdit()">
    <div class="eedit-box">
        <h3>✏️ Edit Event</h3>
        <div class="eedit-field">
            <label>Event Name</label>
            <input type="text" id="eedit-label" maxlength="100">
        </div>
        <div class="eedit-field">
            <label>Start Date</label>
            <input type="date" id="eedit-date">
        </div>
        <div class="eedit-field">
            <label>End Date</label>
            <input type="date" id="eedit-end-date">
        </div>
        <div class="eedit-field">
            <label>Description</label>
            <input type="text" id="eedit-desc" maxlength="160">
        </div>
        <div class="eedit-field">
            <label>Status</label>
            <select id="eedit-status">
                <option value="auto">Auto-detect</option>
                <option value="active">Active (highlighted)</option>
                <option value="upcoming">Upcoming</option>
                <option value="past">Past</option>
            </select>
        </div>
        <div class="eedit-field">
            <label>Time Change</label>
            <select id="eedit-timechange">
                <option value="">None</option>
                <option value="extended">⏳ Extended</option>
                <option value="shortened">⏩ Shortened</option>
            </select>
            <span class="eedit-timechange-hint">Shows a badge on the home page if the event duration was changed.</span>
        </div>
        <div class="eedit-actions">
            <button type="button" class="btn btn-green" onclick="saveEventEdit()">💾 Save</button>
            <button type="button" class="btn btn-ghost" onclick="closeEventEdit()">Cancel</button>
        </div>
    </div>
</div>

<script>
    // @ts-nocheck — plain JS, not TypeScript (see players/index.astro for context)
    import { ref, get, onValue, set, push, update, remove, child } from 'firebase/database';
    import { ref as storageRef, uploadBytesResumable, getDownloadURL, deleteObject } from 'firebase/storage';
    import { signInWithPopup, signOut, onAuthStateChanged } from 'firebase/auth';
    import { db, auth, storage, googleProvider } from '../../scripts/firebase-client.js';

    /* ── XSS safety ── */
    function esc(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    /* ── Confirm modal ── */
    let confirmResolve = null;
    function showConfirm(title, message) {
        return new Promise(resolve => {
            confirmResolve = resolve;
            document.getElementById('confirm-title').textContent = title;
            document.getElementById('confirm-message').textContent = message;
            const modal = document.getElementById('confirm-modal');
            modal.classList.add('active');
            document.getElementById('confirm-yes').onclick = () => {
                modal.classList.remove('active');
                const r = confirmResolve;
                confirmResolve = null;
                if (r) r(true);
            };
        });
    }
    function closeConfirm() {
        document.getElementById('confirm-modal').classList.remove('active');
        const r = confirmResolve;
        confirmResolve = null;
        if (r) r(false);
    }

    /* ── Search & Filter state ── */
    let currentRoleFilter = 'all';
    function setRoleFilter(role) {
        currentRoleFilter = role;
        document.querySelectorAll('.role-filter-pill').forEach(p =>
            p.classList.toggle('active', p.dataset.role === role)
        );
        filterMembers();
    }
    function filterMembers() {
        const query = (document.getElementById('member-search')?.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('.member-table tbody tr');
        rows.forEach(row => {
            const name = (row.querySelector('.member-name-colored')?.textContent || '').toLowerCase();
            const role = (row.querySelector('.role-pill')?.textContent || '').toLowerCase();
            const matchSearch = !query || name.includes(query);
            const matchRole   = currentRoleFilter === 'all' || role === currentRoleFilter;
            row.style.display = (matchSearch && matchRole) ? '' : 'none';
        });
    }

    /* ── Keyboard shortcuts ── */
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            // Close any open modal or cancel editing
            if (document.getElementById('confirm-modal').classList.contains('active')) { closeConfirm(); return; }
            if (document.getElementById('eedit-modal').classList.contains('active')) { closeEventEdit(); return; }
            if (document.getElementById('gedit-modal').classList.contains('active')) { closeGalleryEdit(); return; }
            // Cancel inline edit if one is active
            if (document.querySelector('.edit-row')) { renderTable(); }
        }
    });

    function switchTab(tab) {
        document.querySelectorAll('.admin-tab-btn').forEach(b =>
            b.classList.toggle('active', b.dataset.tab === tab)
        );
        document.getElementById('tab-players').style.display = tab === 'players' ? 'block' : 'none';
        document.getElementById('tab-gallery').style.display = tab === 'gallery' ? 'block' : 'none';
        document.getElementById('tab-events').style.display  = tab === 'events'  ? 'block' : 'none';
        document.getElementById('tab-downloads').style.display = tab === 'downloads' ? 'block' : 'none';
        document.getElementById('tab-applications').style.display = tab === 'applications' ? 'block' : 'none';
    }

    const MEMBERS_REF = ref(db, 'members');
    const AUTH_REF    = ref(db, 'authorizedEmails');
    const APPLICATIONS_REF = ref(db, 'staffApplications');

    let membersCache = [];
    let membersListener = null;
    let applicationsCache = [];
    let applicationsListener = null;
    let appStatusFilter = 'all';
    let appRoleFilter = 'all';
    const expandedAppKeys = new Set();
    const collapsedQaGroups = new Set();
    let currentAdminUser = null;

    const APP_ROLE_LABEL = { social: 'Social', community: 'Community', events: 'Events' };
    const APP_RATING_CATEGORIES = [
        ['activityAvailability', 'Activity Availability'],
        ['communication', 'Communication'],
        ['maturity', 'Maturity'],
        ['judgment', 'Judgment'],
        ['communityKnowledge', 'Community Knowledge'],
        ['initiative', 'Initiative'],
        ['eventCreativity', 'Event Creativity'],
        ['reliability', 'Reliability'],
    ];

    /* ── Render stat cards ── */
    function renderStats() {
        const container = document.getElementById('admin-stats');
        if (!container) return;
        const counts = { total: membersCache.length, staff: 0, trialstaff: 0, member: 0 };
        membersCache.forEach(m => {
            let r = (m.role || '').toLowerCase();
            if (r === 'owner') r = 'staff';
            if (r === 'mod' || r === 'admin') r = 'staff';
            if (counts.hasOwnProperty(r)) counts[r]++;
        });
        container.innerHTML = [
            { cls: 'stat-total',  n: counts.total,  l: 'Total' },
            { cls: 'stat-staff',  n: counts.staff,  l: 'Staff' },
            { cls: 'stat-trialstaff',  n: counts.trialstaff,  l: 'Trial Staff' },
            { cls: 'stat-member', n: counts.member, l: 'Members' },
        ].map(s => `
            <div class="admin-stat-card ${s.cls}">
                <span class="admin-stat-number">${s.n}</span>
                <span class="admin-stat-label">${s.l}</span>
            </div>
        `).join('');
    }

    // ── Check whether the signed-in user's UID is in /authorizedEmails ──
    // Returns: { allowed: bool, error: string|null }
    async function isAuthorized(user) {
        try {
            const snap = await get(child(AUTH_REF, user.uid));
            const allowed = snap.exists();
            return { allowed, error: allowed ? null : `${user.email} is not on the authorised list.` };
        } catch (e) {
            console.error('[Auth] Authorization check failed:', e);
            return { allowed: false, error: `Database read failed (${e.code || e.message}). Check your Firebase rules allow reads of /authorizedEmails.` };
        }
    }

    // ── Auth state observer — handles login, logout and page refresh ──
    onAuthStateChanged(auth, async user => {
        if (user) {
            const { allowed, error } = await isAuthorized(user);
            if (!allowed) {
                await signOut(auth);
                const errorEl = document.getElementById('login-error');
                errorEl.textContent   = `Access denied — ${error}`;
                errorEl.style.display = 'block';
                return;
            }
            loadAndShowPanel(user);
        } else {
            document.getElementById('admin-panel').style.display = 'none';
            document.getElementById('login-gate').style.display  = 'flex';
        }
    });

    async function loginWithGoogle() {
        const errorEl = document.getElementById('login-error');
        errorEl.style.display = 'none';
        try {
            await signInWithPopup(auth, googleProvider);
            // onAuthStateChanged will call loadAndShowPanel
        } catch (e) {
            console.error(e);
            errorEl.textContent   = e.message || 'Google sign-in failed.';
            errorEl.style.display = 'block';
        }
    }

    function logout() {
        if (membersListener) { membersListener(); membersListener = null; }
        if (applicationsListener) { applicationsListener(); applicationsListener = null; }
        signOut(auth);
    }

    function loadAndShowPanel(user) {
        document.getElementById('login-gate').style.display  = 'none';
        document.getElementById('admin-panel').style.display = 'block';

        currentAdminUser = user;

        // Show logged-in user info
        if (user) {
            const userEl = document.getElementById('admin-user');
            const avatarEl = document.getElementById('admin-user-avatar');
            const nameEl = document.getElementById('admin-user-name');
            if (user.photoURL) avatarEl.src = user.photoURL;
            else avatarEl.style.display = 'none';
            nameEl.textContent = user.displayName || user.email;
            userEl.style.display = 'flex';
        }

        // Detach any stale listener before attaching a fresh one
        if (membersListener) { membersListener(); membersListener = null; }

        membersListener = onValue(MEMBERS_REF, snap => {
            const raw = snap.val();
            membersCache = raw ? (Array.isArray(raw) ? raw : Object.values(raw)) : [];
            renderTable();
            renderStats();
            populateUploaderDropdowns();
            document.getElementById('member-count').textContent = `${membersCache.length} members`;
            document.getElementById('seed-banner').style.display = membersCache.length === 0 ? 'flex' : 'none';
        }, e => {
            console.error('Failed to load members:', e);
            document.getElementById('members-container').innerHTML =
                `<div class="loading" style="color:var(--red)">Failed to load members: ${e.message}<br>Check your Firebase database rules.</div>`;
        });

        // Detach any stale listener before attaching a fresh one
        if (applicationsListener) { applicationsListener(); applicationsListener = null; }

        applicationsListener = onValue(APPLICATIONS_REF, snap => {
            const data = snap.val();
            applicationsCache = data ? Object.entries(data).sort((a, b) => (b[1].submittedAt || 0) - (a[1].submittedAt || 0)) : [];
            renderApplicationsAdmin();
        }, e => {
            console.error('[Applications] Failed to load:', e);
            document.getElementById('app-list').innerHTML =
                `<div class="loading" style="color:var(--red)">Failed to load applications: ${e.message}<br>Check your Firebase database rules.</div>`;
        });
    }

