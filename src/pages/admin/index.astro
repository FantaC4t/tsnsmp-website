            <tr id="row-${realIdx}">
                <td>
                    <img class="member-avatar" src="https://mc-heads.net/avatar/${encodeURIComponent(m.name)}/28" alt="" onerror="this.style.display='none'">
                    <strong class="member-name-colored" ${m.color ? `style="color:${esc(m.color)}"` : ''}>${safeName}</strong>
                </td>
                <td><span class="role-pill role-${esc(m.role)}">${esc(m.role)}</span></td>
                <td>${safePronouns}</td>
                <td>${safeTwitch}</td>
                <td class="td-actions">
                    <button class="btn btn-edit" onclick="startEdit(${realIdx})">✏️ Edit</button>
                    <button class="btn btn-danger" id="del-btn-${realIdx}" onclick="confirmRemove(${realIdx})">🗑️ Remove</button>
                </td>
            </tr>
        `}).join('');

        document.getElementById('members-container').innerHTML = `
            <div class="table-scroll">
            <table class="member-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Role</th>
                        <th>Pronouns</th>
                        <th>Twitch</th>
                        <th style="text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
            </div>
        `;

        // Re-apply any active search/filter
        filterMembers();
    }

    // ── Add ──
    async function addMember() {
        const name     = document.getElementById('add-name').value.trim();
        const role     = document.getElementById('add-role').value;
        const pronouns = document.getElementById('add-pronouns').value.trim();
        const color    = document.getElementById('add-color-text').value.trim();
        const twitch   = document.getElementById('add-twitch').value.trim();

        if (!name) { showToast('Username is required', 'error'); return; }
        if (membersCache.find(m => m.name.toLowerCase() === name.toLowerCase())) {
            showToast(`${name} already exists`, 'error'); return;
        }

        membersCache.push({ name, role, pronouns, color, twitch });
        try {
            await saveMembers();
            showToast(`✅ ${name} added!`, 'success');
            ['add-name','add-pronouns','add-color-text','add-twitch'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('add-color-pick').value = '#7B68EE';
            document.getElementById('add-role').value = 'member';
            updatePreview();
        } catch (e) {
            membersCache.pop();
            showToast('Failed to save — check console', 'error');
            console.error(e);
        }
    }

