                ${ratingGroup}

                <div class="app-card-actions">
                    <button type="button" class="btn btn-approve" onclick="setAppStatus('${key}','accepted')">✅ Accept</button>
                    <button type="button" class="btn btn-danger" onclick="setAppStatus('${key}','rejected')">❌ Reject</button>
                    <button type="button" class="btn btn-ghost" onclick="setAppStatus('${key}','pending')">↩️ Reset to Pending</button>
                    <button type="button" class="btn btn-danger" onclick="deleteApplication('${key}')">🗑️ Delete</button>
                </div>
            </div>
        </div>`;
    }

    function renderAppStats() {
        const container = document.getElementById('app-stats');
        if (!container) return;
        const counts = { total: applicationsCache.length, pending: 0, accepted: 0, rejected: 0 };
        applicationsCache.forEach(([, a]) => {
            const s = a.status || 'pending';
            if (counts.hasOwnProperty(s)) counts[s]++;
        });
        container.innerHTML = [
            { cls: 'stat-app-total',    n: counts.total,    l: 'Total' },
            { cls: 'stat-app-pending',  n: counts.pending,  l: 'Pending' },
            { cls: 'stat-app-accepted', n: counts.accepted, l: 'Accepted' },
            { cls: 'stat-app-rejected', n: counts.rejected, l: 'Rejected' },
        ].map(s => `
            <div class="admin-stat-card ${s.cls}">
                <span class="admin-stat-number">${s.n}</span>
                <span class="admin-stat-label">${s.l}</span>
            </div>
        `).join('');
    }

    function renderApplicationsAdmin() {
        const list    = document.getElementById('app-list');
        const countEl = document.getElementById('app-count');
        if (!list) return;
        const query    = (document.getElementById('app-search')?.value || '').trim().toLowerCase();
        const sortMode = document.getElementById('app-sort')?.value || 'newest';

        renderAppStats();

        let items = [...applicationsCache];
        if (appStatusFilter !== 'all') items = items.filter(([, a]) => (a.status || 'pending') === appStatusFilter);
        if (appRoleFilter !== 'all')   items = items.filter(([, a]) => (a.roles || []).includes(appRoleFilter));
        if (query) {
            items = items.filter(([, a]) => {
                const d = (a.basic?.discordUsername || '').toLowerCase();
                const m = (a.basic?.minecraftUsername || '').toLowerCase();
                return d.includes(query) || m.includes(query);
            });
        }

        items.sort((a, b) => {
            if (sortMode === 'oldest') return (a[1].submittedAt || 0) - (b[1].submittedAt || 0);
            if (sortMode === 'rating-high' || sortMode === 'rating-low') {
                const ra = appAvgRating(a[1]), rb = appAvgRating(b[1]);
                if (ra === null && rb === null) return (b[1].submittedAt || 0) - (a[1].submittedAt || 0);
                if (ra === null) return 1;
                if (rb === null) return -1;
                return sortMode === 'rating-high' ? rb - ra : ra - rb;
            }
            return (b[1].submittedAt || 0) - (a[1].submittedAt || 0); // newest (default)
        });

        if (countEl) countEl.textContent = `(${items.length}/${applicationsCache.length})`;

        if (!items.length) {
            list.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No applications</p></div>';
            return;
        }

        list.innerHTML = items.map(([key, app]) => renderApplicationCard(key, app)).join('');
    }

    async function setAppStatus(key, status) {
        if (status === 'accepted' || status === 'rejected') {
            const ok = await showConfirm(
                `${status === 'accepted' ? 'Accept' : 'Reject'} this application?`,
                `This will mark the application as ${status}.`
            );
            if (!ok) return;
        }
        try {
            await update(child(APPLICATIONS_REF, key), { status });
            showToast(`Status set to ${status}`, 'success');
        } catch (e) {
            showToast('Failed to update status: ' + e.message, 'error');
        }
    }

    async function saveAppRating(key) {
        if (!currentAdminUser) { showToast('You must be signed in to rate', 'error'); return; }
        const rating = {};
        APP_RATING_CATEGORIES.forEach(([id]) => {
            const v = document.getElementById(`rating-${key}-${id}`)?.value;
            if (v) rating[id] = parseInt(v, 10);
        });
        rating.raterName = currentAdminUser.displayName || currentAdminUser.email || 'Unknown';
        rating.ratedAt = Date.now();
        try {
            // Multi-path update targets only this rater's own slot, leaving
            // every other staff member's vote on this application untouched.
            await update(child(APPLICATIONS_REF, key), { [`internalRatings/${currentAdminUser.uid}`]: rating });
            showToast('✅ Your rating was saved', 'success');
        } catch (e) {
            showToast('Failed to save rating: ' + e.message, 'error');
        }
    }

    // Small popover breakdown of collective per-category averages, opened by
    // clicking the ⭐ badge on a card's collapsed summary — works whether or
    // not the card itself is expanded.
    function toggleRatingBreakdown(key, evt) {
        evt.stopPropagation();
        const existing = document.querySelector('.app-rating-popover');
        if (existing) {
            const wasSameBadge = existing.dataset.key === key;
            existing.remove();
            if (wasSameBadge) return;
        }

        const app = applicationsCache.find(([k]) => k === key)?.[1];
        if (!app) return;
        const categoryAverages = appCategoryAverages(app);
        const raterCount = appRaterCount(app);

        const popover = document.createElement('div');
        popover.className = 'app-rating-popover';
        popover.dataset.key = key;
        popover.innerHTML = `
            <div class="app-rating-popover-title">Collective ratings <span>(${raterCount} rater${raterCount === 1 ? '' : 's'})</span></div>
            ${APP_RATING_CATEGORIES.map(([id, label]) => {
                const c = categoryAverages[id];
                return `<div class="app-rating-popover-row"><span>${esc(label)}</span><span>${c ? `⭐ ${c.avg.toFixed(1)} <em>(${c.count})</em>` : '—'}</span></div>`;
            }).join('')}
        `;
        evt.currentTarget.appendChild(popover);

        setTimeout(() => {
            document.addEventListener('click', function closeOnce(e) {
                if (!popover.contains(e.target)) {
                    popover.remove();
                    document.removeEventListener('click', closeOnce);
                }
            });
        }, 0);
    }

    async function deleteApplication(key) {
        const ok = await showConfirm('Delete application?', 'This will permanently remove this application.');
        if (!ok) return;
        try {
            await remove(child(APPLICATIONS_REF, key));
            showToast('🗑️ Application deleted', 'success');
        } catch (e) {
            showToast('Delete failed: ' + e.message, 'error');
        }
    }

    // The HTML above calls all of these via inline onclick/onchange/oninput
    // attributes, which need real global lookups — see gallery/index.astro
    // for why (this is now an ES module, and module top-level declarations
    // aren't automatically exposed on `window` the way a classic script's are).
    Object.assign(window, {
        loginWithGoogle, logout, setRoleFilter, filterMembers, switchTab,
        updatePreview, addMember, confirmRemove, startEdit, saveEdit,
        seedMembers, handleGalleryDrop, onGalleryFileSelect, clearGalleryFile,
        uploadGalleryImage, editGalleryItem, closeGalleryEdit, saveGalleryEdit,
        deleteGalleryItem, approveQueueItem, declineQueueItem,
        addEvent, deleteEvent, openEventEdit, closeEventEdit, saveEventEdit,
        addDownload, deleteDownload, editDownloadField,
        closeConfirm, renderTable,
        setAppStatusFilter, setAppRoleFilter, toggleAppCard, toggleQaGroup, renderApplicationsAdmin,
        setAppStatus, saveAppRating, deleteApplication, toggleRatingBreakdown,
    });
</script>
</Layout>
