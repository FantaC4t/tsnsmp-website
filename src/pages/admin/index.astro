    async function approveQueueItem(key) {
        try {
            const snap = await get(child(QUEUE_REF, key));
            const item = snap.val();
            if (!item) { showToast('Item not found', 'error'); return; }

            const newEntry = {
                title:       item.title       || '',
                description: item.description || '',
                url:         item.url,
                storagePath: item.storagePath  || '',
                uploadedBy:  item.submittedBy  || 'Anonymous',
                uploadedAt:  Date.now(),
                ...(item.season ? { season: item.season } : {})
            };
            await push(GALLERY_REF, newEntry);

            await remove(child(QUEUE_REF, key));

            showToast('✅ Image approved and published!', 'success');
            loadQueueAdmin();
            loadGalleryAdmin();
        } catch(e) {
            console.error('[Approve] Error:', e);
            showToast('Approval failed: ' + e.message, 'error');
        }
    }

    async function declineQueueItem(key, storagePath) {
        const ok = await showConfirm('Decline submission?', 'This will permanently delete this submission.');
        if (!ok) return;
        try {
            if (storagePath) await deleteObject(storageRef(storage, storagePath)).catch(() => {});
            await remove(child(QUEUE_REF, key));
            showToast('🗑️ Submission declined', 'success');
            loadQueueAdmin();
        } catch(e) {
            showToast('Decline failed: ' + e.message, 'error');
        }
    }

