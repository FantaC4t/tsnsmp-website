    // ── Client-side compression before upload (see gallery page for the
    // rationale — real uploads are often multi-MB raw screenshots) ──
    async function compressImage(file, { maxDimension = 1920, quality = 0.82 } = {}) {
        if (file.type === 'image/gif') return file; // would flatten animation
        let bitmap;
        try {
            bitmap = await createImageBitmap(file);
        } catch (e) {
            return file; // unsupported/corrupt — let Storage/Firebase reject it downstream
        }
        const scale = Math.min(1, maxDimension / Math.max(bitmap.width, bitmap.height));
        if (scale === 1 && file.size < 400 * 1024) {
            bitmap.close?.();
            return file; // already small enough, not worth re-encoding
        }
        const canvas = document.createElement('canvas');
        canvas.width  = Math.round(bitmap.width  * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close?.();
        const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/jpeg', quality));
        if (!blob || blob.size >= file.size) return file; // re-encode didn't help
        const newName = file.name.replace(/\.[^.]+$/, '') + '.jpg';
        return new File([blob], newName, { type: 'image/jpeg' });
    }

    async function uploadGalleryImage() {
        if (!galleryFileObj) { showToast('Please select an image first', 'error'); return; }
        const title = document.getElementById('gallery-title').value.trim();
        const desc  = document.getElementById('gallery-desc').value.trim();

        galleryFileObj = await compressImage(galleryFileObj);

        const ext   = galleryFileObj.name.split('.').pop();
        const path  = `gallery/${Date.now()}.${ext}`;

        const progressWrap = document.getElementById('gallery-progress-wrap');
        const progressBar  = document.getElementById('gallery-progress-bar');
        progressWrap.style.display = 'block';

        const task = uploadBytesResumable(storageRef(storage, path), galleryFileObj);
        task.on('state_changed',
            snap => {
                const pct = Math.round(snap.bytesTransferred / snap.totalBytes * 100);
                progressBar.style.width = pct + '%';
            },
            err => {
                showToast('Upload failed: ' + err.message, 'error');
                progressWrap.style.display = 'none';
            },
            async () => {
                const url = await getDownloadURL(task.snapshot.ref);
                const seasonRaw = document.getElementById('gallery-season').value;
                const seasonEntry = seasonRaw ? { season: parseInt(seasonRaw, 10) } : {};
                const uploader = document.getElementById('gallery-uploader').value;
                const uploaderEntry = uploader ? { uploadedBy: uploader } : {};
                await push(GALLERY_REF, { title, description: desc, url, storagePath: path, uploadedAt: Date.now(), ...seasonEntry, ...uploaderEntry });
                showToast('✅ Image uploaded!', 'success');
                progressWrap.style.display = 'none';
                progressBar.style.width = '0';
                clearGalleryFile();
                document.getElementById('gallery-title').value = '';
                document.getElementById('gallery-desc').value = '';
                document.getElementById('gallery-season').value = '';
                document.getElementById('gallery-uploader').value = '';
                loadGalleryAdmin();
            }
        );
    }

    function loadGalleryAdmin() {
        const grid = document.getElementById('gallery-admin-grid');
        get(GALLERY_REF).then(snap => {
            const items = [];
            snap.forEach(child => {
                const val = child.val();
                if (val && val.url) items.push({ key: child.key, ...val });
            });
            items.sort((a, b) => (b.uploadedAt || 0) - (a.uploadedAt || 0));
            if (!items.length) {
                grid.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No images yet</p></div>';
                return;
            }
            const seasonLabel = { 1: '🌱 S1', 2: '☀️ S2', 3: '🚀 S3' };
            grid.innerHTML = items.map(item => `
                <div class="gallery-admin-item">
                    <img src="${esc(item.url)}" alt="${esc(item.title || '')}" loading="lazy">
                    <div class="gallery-admin-item-info">
                        <strong>${esc(item.title || '(no title)')}${item.season ? ` <span class="admin-season-badge">${esc(seasonLabel[item.season] || 'S' + item.season)}</span>` : ''}</strong>
                        <span>${esc(item.description || '')}</span>
                        <span style="font-size:.7rem;opacity:.55">${esc(item.uploadedBy || '')}</span>
                    </div>
                    <div class="gallery-item-actions">
                        <button class="btn btn-edit" onclick="editGalleryItem('${item.key}')">✏️ Edit</button>
                        <button class="btn btn-danger" onclick="deleteGalleryItem('${item.key}','${item.storagePath || ''}')">🗑️</button>
                    </div>
                </div>
            `).join('');
        }, err => {
            console.error('[Gallery] Failed to read /gallery:', err);
        });
    }

