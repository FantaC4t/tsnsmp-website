    function appQaRow(label, value) {
        const isEmpty = value === undefined || value === null || value === '';
        return `<div class="qa-row"><span class="qa-q">${esc(label)}</span><span class="qa-a${isEmpty ? ' empty' : ''}">${isEmpty ? '—' : esc(String(value))}</span></div>`;
    }

    // Wraps a category's rows in a collapsible group with a clickable header.
    // Collapse state is tracked per application+category so it survives
    // re-renders (live Firebase updates, filter/sort changes, etc.).
    function appQaGroup(key, idx, titleHtml, bodyHtml) {
        const collapsed = collapsedQaGroups.has(`${key}::${idx}`);
        return `
        <div class="app-qa-group${collapsed ? ' collapsed' : ''}" data-key="${key}" data-idx="${idx}">
            <h4 class="app-qa-toggle" onclick="toggleQaGroup('${key}', ${idx})">
                <span class="app-qa-chevron">▾</span> ${titleHtml}
            </h4>
            <div class="app-qa-body">${bodyHtml}</div>
        </div>`;
    }

    function toggleQaGroup(key, idx) {
        const k = `${key}::${idx}`;
        if (collapsedQaGroups.has(k)) collapsedQaGroups.delete(k); else collapsedQaGroups.add(k);
        const group = document.querySelector(`.app-qa-group[data-key="${key}"][data-idx="${idx}"]`);
        if (group) group.classList.toggle('collapsed', collapsedQaGroups.has(k));
    }

    function toggleAppCard(key) {
        const card = document.querySelector(`.app-card[data-key="${key}"]`);
        if (!card) return;
        const isExpanded = card.classList.toggle('expanded');
        if (isExpanded) expandedAppKeys.add(key); else expandedAppKeys.delete(key);
    }

    // Per-category collective averages across every staff member who has
    // voted on this application — e.g. { activityAvailability: { avg: 4.3, count: 3 }, ... }
    function appCategoryAverages(app) {
        const raters = Object.values(app.internalRatings || {});
        const result = {};
        APP_RATING_CATEGORIES.forEach(([id]) => {
            const vals = raters.map(r => r[id]).filter(v => typeof v === 'number');
            if (vals.length) result[id] = { avg: vals.reduce((a, b) => a + b, 0) / vals.length, count: vals.length };
        });
        return result;
    }

    // Overall badge number — the average of whichever per-category averages
    // have at least one vote, so it stays a sensible summary of the breakdown.
    function appAvgRating(app) {
        const categoryAverages = Object.values(appCategoryAverages(app));
        if (!categoryAverages.length) return null;
        return categoryAverages.reduce((a, c) => a + c.avg, 0) / categoryAverages.length;
    }

    function appRaterCount(app) {
        return Object.keys(app.internalRatings || {}).length;
    }

    function appPendingDays(app) {
        if ((app.status || 'pending') !== 'pending' || !app.submittedAt) return null;
        return Math.floor((Date.now() - app.submittedAt) / 86400000);
    }

