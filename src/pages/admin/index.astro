    /* ── Event Edit Modal ── */
    let editingEventKey = null;
    let editingEventOriginalEndDate = null;

    function openEventEdit(key, ev) {
        editingEventKey = key;
        editingEventOriginalEndDate = ev.originalEndDate || ev.endDate || ev.date;
        document.getElementById('eedit-label').value      = ev.label || '';
        document.getElementById('eedit-date').value       = ev.date || '';
        document.getElementById('eedit-end-date').value   = ev.endDate || '';
        document.getElementById('eedit-desc').value       = ev.description || '';
        document.getElementById('eedit-status').value     = ev.status || 'auto';
        document.getElementById('eedit-timechange').value = ev.timeChange || '';
        document.getElementById('eedit-modal').classList.add('active');
    }

    function closeEventEdit() {
        document.getElementById('eedit-modal').classList.remove('active');
        editingEventKey = null;
    }

    async function saveEventEdit() {
        if (!editingEventKey) return;
        const label     = document.getElementById('eedit-label').value.trim();
        const date      = document.getElementById('eedit-date').value;
        const endDate   = document.getElementById('eedit-end-date').value;
        const desc      = document.getElementById('eedit-desc').value.trim();
        const status    = document.getElementById('eedit-status').value;
        let timeChange  = document.getElementById('eedit-timechange').value;

        if (!label || !date) return showToast('Name and date are required', 'error');
        if (endDate && endDate < date) return showToast('End date must be on or after start date', 'error');

        // Auto-detect time change if the end date was modified
        const effectiveNewEnd = endDate || date;
        const effectiveOrigEnd = editingEventOriginalEndDate || date;
        if (!timeChange && effectiveNewEnd !== effectiveOrigEnd) {
            timeChange = effectiveNewEnd > effectiveOrigEnd ? 'extended' : 'shortened';
        }

        const payload = {
            label,
            date,
            description: desc,
            status,
        };
        if (endDate) {
            payload.endDate = endDate;
        } else {
            payload.endDate = null; // remove if cleared
        }
        // Store original end date on first edit so future comparisons work
        if (!editingEventOriginalEndDate || editingEventOriginalEndDate === date) {
            // first time setting, save current as original
        } else {
            payload.originalEndDate = editingEventOriginalEndDate;
        }
        payload.timeChange = timeChange || null;

        try {
            await update(child(EVENTS_REF, editingEventKey), payload);
            showToast('✏️ Event updated', 'success');
            closeEventEdit();
        } catch (e) {
            showToast('Update failed: ' + e.message, 'error');
        }
    }

    function getEventStatus(event) {
        if (event.status && event.status !== 'auto') return event.status;
        const now = new Date();
        const today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
        const end = event.endDate || event.date;
        if (event.date <= today && today <= end) return 'active';
        return event.date > today ? 'upcoming' : 'past';
    }

    function renderEventsAdmin(snap) {
        const container = document.getElementById('events-admin-list');
        const countEl   = document.getElementById('event-count');
        const data = snap.val();

        if (!data) {
            container.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No events yet</p></div>';
            countEl.textContent = '(0)';
            return;
        }

        const entries = Object.entries(data).sort((a, b) => {
            // Sort by date descending (newest first)
            return b[1].date.localeCompare(a[1].date);
        });

        countEl.textContent = `(${entries.length})`;

        const statusColors = {
            active:   '#FF9800',
            upcoming: 'var(--s3-teal)',
            past:     'var(--muted)'
        };

        container.innerHTML = entries.map(([key, ev]) => {
            const st = getEventStatus(ev);
            const color = statusColors[st] || 'var(--muted)';
            const tcBadge = ev.timeChange === 'extended'
                ? '<span style="background:rgba(255,152,0,.15);color:#FF9800;padding:2px 8px;border-radius:6px;font-size:.7rem;font-weight:700">⏳ EXTENDED</span>'
                : ev.timeChange === 'shortened'
                ? '<span style="background:rgba(var(--s3-teal-rgb),.15);color:var(--s3-teal);padding:2px 8px;border-radius:6px;font-size:.7rem;font-weight:700">⏩ SHORTENED</span>'
                : '';
            const evJson = JSON.stringify(ev).replace(/'/g, '&#39;').replace(/"/g, '&quot;');
            return `
            <div class="admin-list-item" style="color:${color};border-left-color:${color}">
                <div style="flex:1;min-width:0">
                    <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap">
                        <strong class="admin-list-item-title">${esc(ev.label)}</strong>
                        <span style="background:${color}22;color:${color};padding:2px 8px;border-radius:6px;font-size:.75rem;text-transform:uppercase">${st}</span>
                        ${tcBadge}
                    </div>
                    <div class="admin-list-item-meta">
                        📆 ${ev.date}${ev.endDate ? ' → ' + ev.endDate : ''}
                        ${ev.description ? ' · ' + esc(ev.description) : ''}
                    </div>
                </div>
                <div class="admin-list-item-actions">
                    <button onclick='openEventEdit("${key}", JSON.parse(this.dataset.ev))' data-ev="${evJson}"
                        class="btn btn-edit" title="Edit event">✏️</button>
                    <button onclick="deleteEvent('${key}')"
                        class="btn btn-danger" title="Delete">🗑️</button>
                </div>
            </div>`;
        }).join('');
    }

    // Live listener
    onValue(EVENTS_REF, renderEventsAdmin);

