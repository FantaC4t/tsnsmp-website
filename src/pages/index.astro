---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
---

<Layout
    title="TSNSMP | Cozy Minecraft Server"
    description="Cozy whitelist Minecraft SMP with Season 3 applications open. Join a friendly community for building, exploring, and streaming together."
    path="/"
    currentPage="home"
>

<main id="main-content"><!-- Hero Section -->
<section class="hero">
<div class="hero-bg"></div>
<div class="hero-grid"></div>
<div class="hero-gallery-backdrop" id="heroGalleryBackdrop" aria-hidden="true"></div>
<!-- Hand-drawn doodle decorations -->
<div class="hero-doodles" aria-hidden="true">
    <svg class="doodle doodle-star" viewBox="0 0 24 24" fill="none" style="top:13%;right:11%;width:26px" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L13.6 8.6L20 10L13.6 11.4L12 18L10.4 11.4L4 10L10.4 8.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg>
    <svg class="doodle doodle-star doodle-star--sm" viewBox="0 0 24 24" fill="none" style="bottom:30%;left:5%;width:16px" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L13.6 8.6L20 10L13.6 11.4L12 18L10.4 11.4L4 10L10.4 8.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg>
    <svg class="doodle doodle-cross" viewBox="0 0 20 20" fill="none" style="top:65%;right:18%;width:18px" xmlns="http://www.w3.org/2000/svg"><path d="M10 2.5 L10 17.5 M2.5 10 L17.5 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <svg class="doodle doodle-squiggle" viewBox="0 0 80 16" fill="none" style="bottom:16%;right:7%;width:68px" xmlns="http://www.w3.org/2000/svg"><path d="M2 8C10 3 18 13 26 8C34 3 42 13 50 8C58 3 66 13 74 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
    <svg class="doodle doodle-dots" viewBox="0 0 44 10" fill="none" style="top:80%;left:10%;width:52px" xmlns="http://www.w3.org/2000/svg"><circle cx="5" cy="5" r="2.2" fill="currentColor" opacity="0.8"/><circle cx="22" cy="5" r="2.2" fill="currentColor" opacity="0.55"/><circle cx="39" cy="5" r="2.2" fill="currentColor" opacity="0.3"/></svg>
    <img class="hero-mascot" src="/assets/mascot.png" alt="" width="120" height="91" style="top:16%;right:14%" />
</div>
<div class="hero-container"><!-- Content -->
<div class="hero-content">
<div class="hero-badge">
<div class="status-indicator"></div>
<span>Season 3 - LIVE NOW</span></div>
<h1><span class="text-reveal">Welcome to</span><br /><span class="gradient-text" data-text="TSNSMP">TSNSMP</span></h1>
<div class="hero-underline" aria-hidden="true"><svg viewBox="0 0 280 12" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M2 9C28 4 56 12 84 7C112 3 140 12 168 7C196 3 224 12 252 7C265 5 274 8 278 7" stroke="url(#heroUGrad)" stroke-width="2.5" stroke-linecap="round" fill="none"/><defs><linearGradient id="heroUGrad" x1="0" x2="1" y1="0" y2="0"><stop offset="0%" stop-color="#7D83C2"/><stop offset="50%" stop-color="var(--s3-teal)"/><stop offset="100%" stop-color="var(--s3-green)"/></linearGradient></defs></svg></div>
<p class="fade-in-up delay-1">Join our cozy survival SMP — build, explore, and make friends with a welcoming (but slightly unhinged) community. If you feel you would fit in! MAKE SURE TO APPLY!
</p>
<div class="hero-server-stats fade-in-up delay-1">
<span>⚔️ 1.21.11 Server </span><span class="stat-dot">◆</span><span>🌍 Season 3 Live</span><span class="stat-dot">◆</span><span>🔒 Kept And Private Community</span>
</div>
<div class="hero-note fade-in-up delay-1">Keep in mind, the server is kept private to ensure a safe and enjoyable experience for all members. The mods on the server are not required on your side but can definitely improve the experience — check out the mods we have in the resources tab!</div>
<div class="hero-member-badge fade-in-up delay-1" id="heroMemberBadge" style="display:none" aria-live="polite">
<span class="member-badge-dot"></span>
<span class="member-badge-text" id="heroMemberCount">0 Members</span>
</div>
<div class="hero-actions fade-in-up delay-2">
    <div class="hero-primary-ctas">
        <a href="#application-section" class="btn-glow pulse-btn"> <span>🎫 Apply Now</span> </a>
        <a href="/about/" class="btn-outline"> 👋 Meet TSNSMP </a>
    </div>
    <div class="hero-social-icons" role="group" aria-label="TSNSMP community links">
        <a href="https://bsky.app/profile/tsnsmp.online" target="_blank" class="btn-icon" rel="noopener noreferrer" aria-label="Follow TSNSMP on Bluesky" title="Follow TSNSMP on Bluesky"><img src="/assets/icons/bluesky.svg" alt="Bluesky" class="btn-icon-img"></a>
    </div>
</div>

</div>

<!-- Polaroid scatter board of member skins -->
<div class="hero-halo-wrap" id="heroHaloWrap" aria-hidden="true">
    <p class="polaroid-hint" aria-hidden="false">Here's some of our amazing members — if they have a <span class="hint-live-dot"></span> glowing red dot, they're live on Twitch!</p>
    <div class="skin-halo" id="skinHalo"></div>
</div>

<!-- Live stream previews (shown when members are streaming on Twitch) -->
<div class="hero-stream-wrap" id="heroStreamWrap" style="display:none" aria-label="Live member streams">
    <div class="stream-header">
        <span class="stream-live-dot"></span>
        <span class="stream-title">Members Live on Twitch</span>
    </div>
    <div class="stream-featured" id="streamFeatured"></div>
    <div class="stream-switcher" id="streamSwitcher"></div>
</div>

</div>
</section>

<section class="events-section reveal">
<div class="container">
<div class="events-wrapper">
    <div class="events-header">
        <h2>What's Happening <span class="emoji">📅</span></h2>
        <p class="events-subtitle">Keep up with what's going on in the SMP</p>
    </div>
    <div class="events-timeline" id="eventsTimeline" aria-busy="true" aria-live="polite">
    <div class="event-skeleton" aria-hidden="true"></div>
    <div class="event-skeleton" aria-hidden="true"></div>
    <div class="event-skeleton" aria-hidden="true"></div>
</div>
</div>
</div>
</section>

<!-- Carousel Section - pulls from Firebase Gallery -->
<section class="player-showcase reveal">
<div class="container">
<h2>Check out some awesome builds! <span class="emoji">🏗️</span></h2>
<p class="section-subtitle">Click any image to expand · Images from our <a href="/gallery/" style="color:var(--primary-purple)">gallery</a></p>
<div class="carousel-container">
<div class="carousel-track" id="carouselTrack" aria-busy="true" aria-live="polite">
    <div class="carousel-item carousel-skeleton" aria-hidden="true"></div>
    <div class="carousel-item carousel-skeleton" aria-hidden="true"></div>
    <div class="carousel-item carousel-skeleton" aria-hidden="true"></div>
    <div class="carousel-item carousel-skeleton" aria-hidden="true"></div>
    <div class="carousel-item carousel-skeleton" aria-hidden="true"></div>
</div>
</div>
</div>
</section>

<!-- Wave divider -->
<div class="section-divider">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80Z" fill="var(--bg-primary)"/><path d="M0,52 C320,72 640,20 960,52 C1120,68 1320,42 1440,52 L1440,80 L0,80Z" fill="var(--bg-primary)" opacity="0.5"/></svg>
</div>

<section class="features reveal">
<div class="section-doodles" aria-hidden="true">
    <svg class="sec-doodle sec-doodle--spiral" viewBox="0 0 40 40" fill="none" style="top:8%;left:2%" xmlns="http://www.w3.org/2000/svg"><path d="M20 20C20 20 24 16 26 20C28 24 24 28 20 28C14 28 10 22 12 16C14 10 22 8 28 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
    <svg class="sec-doodle sec-doodle--arrow" viewBox="0 0 36 24" fill="none" style="bottom:12%;right:3%" xmlns="http://www.w3.org/2000/svg"><path d="M2 12C8 8 16 6 24 8M24 8L19 4M24 8L20 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <svg class="sec-doodle sec-doodle--star" viewBox="0 0 24 24" fill="none" style="top:20%;right:6%" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L13.6 8.6L20 10L13.6 11.4L12 18L10.4 11.4L4 10L10.4 8.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    <svg class="sec-doodle sec-doodle--underline" viewBox="0 0 90 12" fill="none" style="bottom:18%;left:4%" xmlns="http://www.w3.org/2000/svg"><path d="M2 8C18 3 36 12 54 7C66 4 78 9 88 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
</div>
<div class="container">
<h2>Why we think you'll love it here <span class="emoji">✨</span></h2>
<div class="features-grid">
<div class="feature-card">
<div class="feature-icon">🫂</div>
<h3>Tight Knit Community</h3>
<p>With a smaller player base, it's easy to actually get to know people. Everyone is friendly, welcoming, and happy to hang out.</p>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="feature-card">
<div class="feature-icon">🛡️</div>
<h3>Carefully Chosen Members</h3>
<p>Every application is reviewed so the server stays welcoming, safe, and drama-free.</p>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="feature-card">
<div class="feature-icon">🏗️</div>
<h3>Fun Group Projects</h3>
<p>From an apocalyptic city to a whimsical forest, players on our server have come together to make fantastic builds!</p>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="feature-card">
<div class="feature-icon">💬</div>
<h3>Always Someone To Chat With</h3>
<p>There's usually someone online, and voice chat is great for hangouts, laughs, and group adventures.</p>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="feature-card">
<div class="feature-icon">🌱</div>
<h3>New Start, Grand Adventures</h3>
<p>Season 3 brings a fresh world with new goals, new builds, and plenty of chances to make memories together.</p>
<span class="page-fold" aria-hidden="true"></span>
</div>
</div>
</div>
</section>

<section class="customization-showcase reveal">
<div class="section-doodles" aria-hidden="true">
    <svg class="sec-doodle sec-doodle--cross" viewBox="0 0 20 20" fill="none" style="top:10%;left:3%" xmlns="http://www.w3.org/2000/svg"><path d="M10 2.5L10 17.5M2.5 10L17.5 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    <svg class="sec-doodle sec-doodle--sparkle" viewBox="0 0 32 32" fill="none" style="top:15%;right:4%" xmlns="http://www.w3.org/2000/svg"><path d="M16 4V8M16 24V28M4 16H8M24 16H28M7.8 7.8L10.6 10.6M21.4 21.4L24.2 24.2M7.8 24.2L10.6 21.4M21.4 10.6L24.2 7.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <svg class="sec-doodle sec-doodle--squiggle" viewBox="0 0 80 16" fill="none" style="bottom:14%;right:5%" xmlns="http://www.w3.org/2000/svg"><path d="M2 8C10 3 18 13 26 8C34 3 42 13 50 8C58 3 66 13 74 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
</div>
<div class="container">
<h2>Make yourself at home with customization! <span class="emoji">🎨</span></h2>
<div class="customization-grid">
<div class="custom-feature">
<div class="feature-icon">🌈</div>
<h3>Your color, your vibe</h3>
<p>Seriously, pick ANY color! Hot pink? Neon green? That one specific blue that reminds you of your favorite hoodie? We've got you covered!</p>
<div class="color-examples"><span style="color: #ff6200; font-weight: bold; text-shadow: 0 0 8px currentColor;">FantaC4t</span> <span style="color: #af2323; font-weight: bold; text-shadow: 0 0 8px currentColor;">Gaqy</span> <span style="color: #2cb7b9; font-weight: bold; text-shadow: 0 0 8px currentColor;">Cyan_caelum</span></div>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="custom-feature">
<div class="feature-icon">💝</div>
<h3>Pronouns with style</h3>
<p>Share your pronouns your way — we keep the space respectful and welcoming for everyone.</p>
<div class="pronoun-examples"><span class="pronoun-badge">they/them</span> <span class="pronoun-badge">she/her</span> <span class="pronoun-badge">he/him</span> <span class="pronoun-badge">she/they</span> <span class="pronoun-badge">any/all</span></div>
<span class="page-fold" aria-hidden="true"></span>
</div>
<div class="custom-feature">
<div class="feature-icon">📹</div>
<h3>Streaming made easy</h3>
<p>If you stream, we help your content stand out — share your channel and the community can tune in.</p>
<div class="toggle-examples">
<div class="status-example online"><span class="status-indicator"></span> <span>🔴 Streaming now!</span></div>
</div>
<span class="page-fold" aria-hidden="true"></span>
</div>
</div>
</div>
</section>

<!-- Wave divider -->
<div class="section-divider">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,80 L0,80Z" fill="var(--bg-primary)"/><path d="M0,52 C320,72 640,20 960,52 C1120,68 1320,42 1440,52 L1440,80 L0,80Z" fill="var(--bg-primary)" opacity="0.5"/></svg>
</div>

<section class="application-section reveal" id="application-section">
<div class="section-doodles" aria-hidden="true">
    <svg class="sec-doodle sec-doodle--heart" viewBox="0 0 28 26" fill="none" style="top:6%;left:3%" xmlns="http://www.w3.org/2000/svg"><path d="M14 23C14 23 3 16 3 9C3 6 5.5 4 8.5 4C11 4 13 5.5 14 7C15 5.5 17 4 19.5 4C22.5 4 25 6 25 9C25 16 14 23 14 23Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <svg class="sec-doodle sec-doodle--arrow" viewBox="0 0 36 24" fill="none" style="top:30%;right:3%" xmlns="http://www.w3.org/2000/svg"><path d="M2 12C8 8 16 6 24 8M24 8L19 4M24 8L20 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <svg class="sec-doodle sec-doodle--dots" viewBox="0 0 44 10" fill="none" style="bottom:10%;left:2%" xmlns="http://www.w3.org/2000/svg"><circle cx="5" cy="5" r="2.2" fill="currentColor" opacity="0.9"/><circle cx="22" cy="5" r="2.2" fill="currentColor" opacity="0.6"/><circle cx="39" cy="5" r="2.2" fill="currentColor" opacity="0.3"/></svg>
    <svg class="sec-doodle sec-doodle--star" viewBox="0 0 24 24" fill="none" style="bottom:20%;right:5%" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L13.6 8.6L20 10L13.6 11.4L12 18L10.4 11.4L4 10L10.4 8.6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
</div>
<div class="container">
<div class="application-content">
<h2>Join us for Season 3! <span class="emoji">🌸</span></h2>
<p class="app-subtitle">Whether you're a returning player or new here, we'd love to meet you. Apply if you want to build, explore, play with amazing and wonderful people.</p>

<div class="app-layout">
    <!-- Left column: info -->
    <div class="app-info-col">
        <div class="application-requirements">
            <h3>What we look for in applicants:</h3>
            <ul>
                <li>✨ A positive attitude and respect for everyone</li>
                <li>🏗️ A willingness to build, collaborate, and help others. Skill level doesnt matter! We accept EVERYONE!</li>
                <li>🚫 No griefing, drama, or toxic behavior, keep the server positively vibed and not toxic</li>
                <li>🌱 Age 18+ (younger applicants welcome if mature or vouched for) we do our best to accommodate everyone and dont want to be held responsible for more minors.</li>
                <li>🤝 Someone who wants to keep the server friendly and fun and is willing to meet new friends!</li>
            </ul>
        </div>
        <div class="app-response-note">
            <span class="app-response-icon">📬</span>
            <p>Our Process of application is simple and straightforward. All members get a notification on discord and discuss wether or not we want someone.</p>
        </div>
        <div class="app-quick-links">
            <a href="/about/" class="app-quick-link about">
                📖 Learn more about us
            </a>
        </div>
    </div>

    <!-- Right column: form -->
    <div class="app-form-col">
        <div class="application-form-wrapper">
            <form class="custom-apply-form" id="applyForm" novalidate>

                <div class="apply-field">
                    <label class="apply-label" for="apply-mc">What's your Minecraft nickname? <span class="req">*</span></label>
                    <input class="apply-input" id="apply-mc" name="mc" type="text" required placeholder="Steve" maxlength="100">
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-age">What's your age or age range? <span class="req">*</span></label>
                    <input class="apply-input" id="apply-age" name="age" type="text" required placeholder="e.g. 22 or 20-25" maxlength="10">
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-discord">What's your Discord? <span class="req">*</span></label>
                    <input class="apply-input" id="apply-discord" name="discord" type="text" required placeholder="fantacat" maxlength="100">
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-socials">Any other socials?</label>
                    <input class="apply-input" id="apply-socials" name="socials" type="text" placeholder="Twitch, YouTube, Instagram… whatever you'd like to share" maxlength="200">
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-pronouns">What are your pronouns?</label>
                    <input class="apply-input" id="apply-pronouns" name="pronouns" type="text" placeholder="e.g. they/them, she/her, he/him…" maxlength="50">
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="tzTrigger">What is your timezone? <span class="req">*</span></label>
                    <div class="tz-picker" id="tzPickerWrap">
                        <button type="button" class="tz-trigger" id="tzTrigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="tzDropdown">
                            <span class="tz-trigger-text" id="tzDisplay">Select your timezone…</span>
                            <svg class="tz-caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="tz-dropdown" id="tzDropdown" role="listbox" aria-label="Timezones" hidden>
                            <div class="tz-search-wrap">
                                <input type="text" class="tz-filter" id="tzFilter" placeholder="🔍 Search timezones…" autocomplete="off" aria-label="Search timezones">
                            </div>
                            <div class="tz-list" id="tzList"></div>
                        </div>
                        <input type="hidden" name="timezone" id="tzHidden">
                    </div>
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-plans">What are your plans for the server? <span class="req">*</span></label>
                    <textarea class="apply-textarea" id="apply-plans" name="plans" required placeholder="Tell us what you'd like to build, do, or explore…" maxlength="2000"></textarea>
                    <span class="apply-char-count" id="apply-plans-count" aria-live="polite">0 / 2000</span>
                </div>

                <div class="apply-field">
                    <label class="apply-label">Are you a content creator? <span class="req">*</span></label>
                    <div class="apply-radio-group" role="radiogroup" aria-required="true">
                        <label class="apply-radio-label"><input type="radio" name="creator" value="Yes" required> Yes</label>
                        <label class="apply-radio-label"><input type="radio" name="creator" value="No"> No</label>
                        <label class="apply-radio-label"><input type="radio" name="creator" value="Occasionally"> Occasionally</label>
                        <label class="apply-radio-label"><input type="radio" name="creator" value="Planning to start"> Planning to start</label>
                    </div>
                </div>

                <div class="apply-field">
                    <label class="apply-label" for="apply-mob">If you were to be born as any mob from Minecraft, which mob would it be and why? <span class="req">*</span></label>
                    <textarea class="apply-textarea" id="apply-mob" name="mob" required placeholder="Any mob — be creative!" maxlength="2000"></textarea>
                    <span class="apply-char-count" id="apply-mob-count" aria-live="polite">0 / 2000</span>
                </div>

                <div class="apply-field">
                    <label class="apply-label">How did you find out about TSNSMP? <span class="req">*</span></label>
                    <div class="apply-radio-group" role="radiogroup" aria-required="true">
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Friend / Word of mouth" required> 👥 Friend / Word of mouth</label>
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Bluesky"> 🦋 Bluesky</label>
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Member streaming"> 🎥 Member streaming</label>
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Modrinth"> 🟩 Modrinth</label>
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Search engine"> 🔍 Search engine</label>
                        <label class="apply-radio-label"><input type="radio" name="referral" value="Other"> ✏️ Other…</label>
                    </div>
                    <input class="apply-input apply-referral-other" id="apply-referral-other" name="referral_other" type="text" placeholder="How did you find us? Tell us more…" maxlength="200" style="display:none;margin-top:10px">
                </div>

                <div class="apply-status" id="applyStatus" role="alert" aria-live="polite"></div>
                <button class="apply-submit" id="applySubmit" type="submit">🎫 Submit Application</button>
            </form>
        </div>
    </div>
</div>

</div>
</div>
</section>
</main>

<!-- Lightbox - must be outside <main> to avoid stacking context issues -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" aria-hidden="true">
    <button type="button" class="lightbox-close" id="lightbox-close-btn" aria-label="Close image viewer">✕</button>
    <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev-btn" aria-label="Previous image">&#8592;</button>
    <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next-btn" aria-label="Next image">&#8594;</button>
    <div class="lightbox-inner" id="lightbox-inner">
        <img id="lightbox-img" class="lightbox-content" src="" alt="Enlarged view" />
        <div class="lightbox-caption">
            <strong id="lightbox-title"></strong>
            <span id="lightbox-desc"></span>
        </div>
    </div>
</div>

<script>
        // @ts-nocheck — plain JS, not TypeScript (see players/index.astro for context)
        import { ref, get } from 'firebase/database';
        import { db } from '../scripts/firebase-client.js';

        /* -- Gallery-powered carousel (lightbox itself is shared — see scripts/lightbox.js) -- */
        const esc = window.Lightbox.esc;

        /* Load gallery images from Firebase into carousel */
        (function loadCarouselFromGallery() {
            const track = document.getElementById('carouselTrack');
            if (!track) return;

            /* Fallback: local images if Firebase is empty/fails */
            const fallbackImages = [
                { url: '/assets/all_builds.jpg', title: 'Aerial Overview', description: 'Server builds from above' },
                { url: '/assets/gaqster.jpg',    title: 'Gaqy\'s Build',  description: 'Shopping mall build' },
                { url: '/assets/blacksnow.jpg',  title: 'Blacksnow',      description: 'Winter-themed build' },
                { url: '/assets/loftylena.jpg',  title: 'LoftyLena',      description: 'Scenic landscape build' },
                { url: '/assets/cyan.jpg',       title: 'Cyan',           description: 'Colourful base build' },
                { url: '/assets/Fantac4t.jpg',   title: 'FantaC4t',       description: 'Creative build' },
            ];

            function renderTrack(items) {
                window.Lightbox.setItems(items);
                if (!items.length) { track.closest('.player-showcase').style.display = 'none'; return; }
                /* Build items - 2 for seamless loop - use data-index instead of onclick
                   because the CSS scroll animation moves elements between mousedown/up,
                   preventing click events from firing reliably */
                const html = items.map((item, i) => `
                    <div class="carousel-item" data-index="${i}">
                        <img src="${esc(item.url)}" alt="${esc(item.title || 'Gallery image')}" loading="lazy" draggable="false" />
                        ${item.title ? `<div class="carousel-item-label">${esc(item.title)}</div>` : ''}
                    </div>
                `).join('');
                track.innerHTML = html + html; /* duplicate for infinite scroll */
                track.setAttribute('aria-busy', 'false');

                /* Re-calc animation duration based on actual CSS item width */
                const firstItem = track.querySelector('.carousel-item');
                const itemWidth = firstItem ? (parseFloat(getComputedStyle(firstItem).width) || 420) : 420;
                const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 32;
                const totalWidth = items.length * (itemWidth + gap);
                const speed = 50; /* px per second */
                track.style.animationDuration = (totalWidth / speed) + 's';

                /* Populate hero gallery backdrop with random images */
                populateHeroBackdrop(items);
            }

            /* Hero gallery backdrop: floating dimmed images behind hero content */
            function populateHeroBackdrop(items) {
                const backdrop = document.getElementById('heroGalleryBackdrop');
                if (!backdrop || !items.length) return;
                /* Pick up to 5 random images */
                const shuffled = items.slice().sort(function() { return 0.5 - Math.random(); });
                const picks = shuffled.slice(0, Math.min(5, items.length));
                /* Predefined positions to avoid overlap */
                const positions = [
                    { top: '8%',  left: '5%',  w: 220 },
                    { top: '55%', left: '2%',  w: 180 },
                    { top: '12%', right: '4%', w: 200 },
                    { top: '60%', right: '6%', w: 190 },
                    { top: '35%', left: '12%', w: 160 },
                ];
                picks.forEach(function(item, i) {
                    var pos = positions[i];
                    var img = document.createElement('img');
                    img.src = item.url;
                    img.alt = '';
                    img.draggable = false;
                    img.className = 'hero-backdrop-img';
                    img.style.width = pos.w + 'px';
                    img.style.top = pos.top;
                    if (pos.left) img.style.left = pos.left;
                    if (pos.right) img.style.right = pos.right;
                    img.style.animationDelay = (i * 2.5) + 's';
                    backdrop.appendChild(img);
                });
            }

            /* Event delegation: handle clicks on carousel items via a static parent.
               Track pointer movement so we only open lightbox on a tap/click, not a drag. */
            (function() {
                const container = track.closest('.carousel-container') || track.parentElement;
                let pointerStartX = 0, pointerStartY = 0;

                container.addEventListener('pointerdown', function(e) {
                    pointerStartX = e.clientX;
                    pointerStartY = e.clientY;
                    /* Pause animation on touch so the item doesn't slide away */
                    track.style.animationPlayState = 'paused';
                }, { passive: true });

                container.addEventListener('pointerup', function(e) {
                    const dx = Math.abs(e.clientX - pointerStartX);
                    const dy = Math.abs(e.clientY - pointerStartY);
                    /* Only count as a tap if pointer barely moved (< 10px) */
                    if (dx < 10 && dy < 10) {
                        const card = e.target.closest('.carousel-item');
                        if (card && card.dataset.index !== undefined) {
                            window.Lightbox.open(parseInt(card.dataset.index, 10));
                        }
                    }
                    /* Resume animation after a short delay */
                    setTimeout(function() {
                        if (!document.getElementById('lightbox').classList.contains('active')) {
                            track.style.animationPlayState = '';
                        }
                    }, 300);
                });

                /* Also resume animation when pointer leaves carousel area */
                container.addEventListener('pointerleave', function() {
                    if (!document.getElementById('lightbox').classList.contains('active')) {
                        track.style.animationPlayState = '';
                    }
                }, { passive: true });
            })();

            try {
                get(ref(db, 'gallery')).then(snap => {
                    const items = [];
                    snap.forEach(child => {
                        const val = child.val();
                        if (val && val.url) items.push({ key: child.key, ...val });
                    });
                    items.sort((a, b) => (b.uploadedAt || 0) - (a.uploadedAt || 0));
                    /* Use gallery if it has images, supplement with fallbacks if under 4 */
                    if (items.length >= 4) {
                        renderTrack(items);
                    } else if (items.length > 0) {
                        /* Merge: gallery first, then enough fallbacks to fill out */
                        const galleryUrls = new Set(items.map(i => i.url));
                        const extras = fallbackImages.filter(f => !galleryUrls.has(f.url));
                        renderTrack([...items, ...extras].slice(0, Math.max(items.length + extras.length, 6)));
                    } else {
                        renderTrack(fallbackImages);
                    }
                }, () => {
                    renderTrack(fallbackImages);
                });
            } catch(e) {
                renderTrack(fallbackImages);
            }
        })();

        // Season 3 events timeline - reads from Firebase
        (function buildEventsTimeline() {
            const container = document.getElementById('eventsTimeline');
            if (!container) return;

            get(ref(db, 'events')).then(snap => {
                const data = snap.val();
                if (!data || Object.keys(data).length === 0) {
                    container.setAttribute('aria-busy', 'false');
                    container.innerHTML = `
                    <div class="events-empty">
                        <img class="events-empty-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" />
                        <p class="events-empty-title">Stay tuned!</p>
                        <p class="events-empty-desc">No events planned right now — but something's always brewing. Check back soon!</p>
                    </div>`;
                    return;
                }

                const events = Object.values(data).sort((a, b) => a.date.localeCompare(b.date));
                const now = new Date();

                events.forEach(ev => {
                    if (!ev.status || ev.status === 'auto') {
                        const end = ev.endDate || ev.date;
                        const dEnd = new Date(end + 'T23:59:59');
                        const today = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
                        if (ev.date <= today && today <= end) {
                            ev.status = 'active';
                        } else {
                            ev.status = dEnd < now ? 'past' : 'upcoming';
                        }
                    }
                });

                const nextEvent = events.find(ev => ev.status === 'active') || events.find(ev => ev.status === 'upcoming');

                container.setAttribute('aria-busy', 'false');

                /* Inject Event structured data for upcoming/active events */
                const upcomingEvents = events.filter(ev => ev.status === 'active' || ev.status === 'upcoming');
                if (upcomingEvents.length) {
                    const ldScript = document.createElement('script');
                    ldScript.type = 'application/ld+json';
                    ldScript.textContent = JSON.stringify({
                        '@context': 'https://schema.org',
                        '@graph': upcomingEvents.map(ev => ({
                            '@type': 'Event',
                            'name': ev.label,
                            'startDate': ev.date,
                            'endDate': ev.endDate || ev.date,
                            'description': ev.description || ev.desc || '',
                            'eventStatus': 'https://schema.org/EventScheduled',
                            'eventAttendanceMode': 'https://schema.org/OnlineEventAttendanceMode',
                            'location': {
                                '@type': 'VirtualLocation',
                                'url': 'https://tsnsmp.com/'
                            },
                            'organizer': {
                                '@type': 'Organization',
                                'name': 'TSNSMP',
                                'url': 'https://tsnsmp.com/'
                            }
                        }))
                    });
                    document.head.appendChild(ldScript);
                }

                container.innerHTML = events.map((ev, i) => {
                    const d = new Date(ev.date + 'T00:00:00');
                    const monthShort = d.toLocaleString('en-GB', { month: 'short' });
                    const day = d.getDate();

                    let endBadge = '';
                    if (ev.endDate && ev.endDate !== ev.date) {
                        const dEnd = new Date(ev.endDate + 'T00:00:00');
                        const endMonth = dEnd.toLocaleString('en-GB', { month: 'short' });
                        const endDay = dEnd.getDate();
                        endBadge = `<span class="event-date-sep">→</span>
                            <div class="event-date-badge event-date-end">
                                <span class="event-month">${endMonth}</span>
                                <span class="event-day">${endDay}</span>
                            </div>`;
                    }

                    const isNext = nextEvent && ev.date === nextEvent.date;
                    const daysToStart = isNext ? Math.max(0, Math.ceil((new Date(ev.date + 'T00:00:00') - now) / 86400000)) : null;
                    const isActive = ev.status === 'active';
                    const endTarget = ev.endDate || ev.date;
                    const daysToEnd = isActive ? Math.max(0, Math.ceil((new Date(endTarget + 'T23:59:59') - now) / 86400000)) : null;
                    const desc = ev.description || ev.desc || '';

                    let countdownHtml = '';
                    if (isActive && daysToEnd !== null) {
                        const txt = daysToEnd === 0 ? 'Ends today!' : daysToEnd === 1 ? 'Ends tomorrow!' : daysToEnd + ' days remaining';
                        countdownHtml = `<span class="event-countdown event-countdown-active">${txt}</span>`;
                    } else if (isNext && daysToStart !== null) {
                        const txt = daysToStart === 0 ? 'Today!' : daysToStart === 1 ? 'Tomorrow!' : daysToStart + ' days left';
                        countdownHtml = `<span class="event-countdown">${txt}</span>`;
                    }

                    let timeChangeBadge = '';
                    if (ev.timeChange === 'extended') {
                        timeChangeBadge = '<span class="event-time-change event-extended">⏰ Extended</span>';
                    } else if (ev.timeChange === 'shortened') {
                        timeChangeBadge = '<span class="event-time-change event-shortened">⏱️ Shortened</span>';
                    }

                    return `
                    <div class="event-card ${ev.status}${isNext ? ' event-next' : ''}" style="--delay:${i * .08}s">
                        <div class="event-date-badge">
                            <span class="event-month">${monthShort}</span>
                            <span class="event-day">${day}</span>
                            ${ev.endDate && ev.endDate !== ev.date ? (() => { const dEnd = new Date(ev.endDate + 'T00:00:00'); return `<span class="event-date-sep">&rarr;</span><span class="event-month">${dEnd.toLocaleString('en-GB',{month:'short'})}</span><span class="event-day">${dEnd.getDate()}</span>`; })() : ''}
                        </div>
                        <strong class="event-label">${ev.label}</strong>
                        ${timeChangeBadge}
                        <span class="event-desc">${desc}</span>
                        ${countdownHtml}
                        ${ev.status === 'past' ? '<span class="event-status-done">✅ Done</span>' : ''}
                    </div>`;
                }).join('');
            }).catch(() => {
                container.setAttribute('aria-busy', 'false');
                container.innerHTML = `
                <div class="events-empty">
                    <img class="events-empty-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" />
                    <p class="events-empty-title">Stay tuned!</p>
                    <p class="events-empty-desc">No events planned right now — but something's always brewing. Check back soon!</p>
                </div>`;
            });
        })();

        /* -- Twitch live-stream detection -- */
        function extractTwitchUsername(url) {
            return url.trim().split('/').filter(Boolean).pop();
        }

        function probeStreamLive(username) {
            /*  Twitch CDN returns a small ~4 KB placeholder for offline users
                and a much larger thumbnail (10 KB+) for live users.
                We fetch the image and check the size to tell the difference. */
            return new Promise(resolve => {
                const timer = setTimeout(() => resolve(false), 4000);
                fetch(`https://static-cdn.jtvnw.net/previews-ttv/live_user_${username.toLowerCase()}-440x248.jpg?cb=${Date.now()}`, { mode: 'cors' })
                    .then(r => {
                        if (!r.ok) { clearTimeout(timer); return resolve(false); }
                        const cl = r.headers.get('content-length');
                        if (cl && parseInt(cl, 10) < 10000) {
                            clearTimeout(timer); return resolve(false); /* placeholder */
                        }
                        return r.blob();
                    })
                    .then(blob => {
                        clearTimeout(timer);
                        if (!blob) return; /* already resolved */
                        resolve(blob.size > 10000); /* real thumbnail > 10 KB */
                    })
                    .catch(() => { clearTimeout(timer); resolve(false); });
            });
        }

        async function detectLiveStreams(members) {
            const CACHE_KEY = 'tsnsmp_stream_cache';
            const CACHE_TTL = 5 * 60 * 1000; // 5 minutes

            // Return cached results if fresh enough
            try {
                const cached = JSON.parse(sessionStorage.getItem(CACHE_KEY) || 'null');
                if (cached && Date.now() - cached.ts < CACHE_TTL) {
                    const nameSet = new Set(cached.names);
                    return members.filter(m => nameSet.has(m.name));
                }
            } catch(e) { /* ignore corrupt cache */ }

            const withTwitch = members
                .filter(m => m.twitch && m.twitch.trim())
                .map(m => ({ ...m, twitchUsername: extractTwitchUsername(m.twitch) }));
            if (!withTwitch.length) return [];
            const results = await Promise.all(
                withTwitch.map(async m => (await probeStreamLive(m.twitchUsername)) ? m : null)
            );
            const liveMembers = results.filter(Boolean);

            // Persist for 5 minutes so navigating back doesn't re-probe
            try {
                sessionStorage.setItem(CACHE_KEY, JSON.stringify({
                    ts: Date.now(),
                    names: liveMembers.map(m => m.name)
                }));
            } catch(e) { /* ignore quota errors */ }

            return liveMembers;
        }

        let currentStreamIdx = 0;

        function renderStreamCards(liveStreams) {
            const featured  = document.getElementById('streamFeatured');
            const switcher  = document.getElementById('streamSwitcher');
            if (!featured) return;

            const parentDomain = location.hostname || 'tsnsmp.com';

            function showStream(idx) {
                currentStreamIdx = idx;
                const member = liveStreams[idx];
                featured.innerHTML = '';

                /* Big iframe player */
                const iframeWrap = document.createElement('div');
                iframeWrap.className = 'stream-player-wrap';

                const iframe = document.createElement('iframe');
                iframe.src = `https://player.twitch.tv/?channel=${encodeURIComponent(member.twitchUsername)}&parent=${parentDomain}&muted=true`;
                iframe.allowFullscreen = true;
                iframe.setAttribute('frameborder', '0');
                iframe.setAttribute('scrolling', 'no');
                iframe.title = `${member.name}'s Twitch stream`;
                iframeWrap.appendChild(iframe);

                /* Info bar */
                const info = document.createElement('div');
                info.className = 'stream-featured-info';

                const avatar = document.createElement('img');
                avatar.className = 'stream-card-avatar';
                avatar.src = `https://minotar.net/helm/${encodeURIComponent(member.name)}/64`;
                avatar.alt = member.name;

                const meta = document.createElement('div');
                meta.className = 'stream-card-meta';

                const nameEl = document.createElement('span');
                nameEl.className = 'stream-card-name';
                nameEl.textContent = member.name;

                const badge = document.createElement('span');
                badge.className = 'stream-card-badge';
                badge.innerHTML = '<span class="live-dot"></span> LIVE';

                meta.appendChild(nameEl);
                meta.appendChild(badge);

                const link = document.createElement('a');
                link.className = 'stream-card-link';
                link.href = member.twitch;
                link.target = '_blank';
                link.rel = 'noopener';
                link.textContent = 'Open on Twitch ↗';

                info.appendChild(avatar);
                info.appendChild(meta);
                info.appendChild(link);

                featured.appendChild(iframeWrap);
                featured.appendChild(info);

                /* Update active tab */
                if (switcher) {
                    switcher.querySelectorAll('.stream-tab').forEach((tab, i) => {
                        tab.classList.toggle('active', i === idx);
                    });
                }
            }

            /* Build switcher tabs (only if 2+) */
            if (switcher) {
                switcher.innerHTML = '';
                if (liveStreams.length > 1) {
                    liveStreams.forEach((member, i) => {
                        const tab = document.createElement('button');
                        tab.className = 'stream-tab' + (i === 0 ? ' active' : '');
                        tab.onclick = () => showStream(i);

                        const av = document.createElement('img');
                        av.src = `https://minotar.net/helm/${encodeURIComponent(member.name)}/48`;
                        av.alt = member.name;
                        av.className = 'stream-tab-avatar';

                        const name = document.createElement('span');
                        name.className = 'stream-tab-name';
                        name.textContent = member.name;

                        const dot = document.createElement('span');
                        dot.className = 'stream-tab-dot';

                        tab.appendChild(av);
                        tab.appendChild(name);
                        tab.appendChild(dot);
                        switcher.appendChild(tab);
                    });
                }
            }

            showStream(0);
        }

        /* -- Polaroid scatter board (shown when no streams are live) -- */
        function buildSkinRing(ring, allMembers) {
            if (!ring) return;
            if (!Array.isArray(allMembers) || allMembers.length === 0) {
                ring.innerHTML = '<p class="skin-orbit-fallback">Join us to appear here!</p>';
                return;
            }

            const MAX_SHOWN = Math.min(12, allMembers.length);
            const shuffled  = [...allMembers].sort(() => Math.random() - 0.5);
            const active    = shuffled.slice(0, MAX_SHOWN);
            const reserve   = shuffled.slice(MAX_SHOWN);

            ring.innerHTML = '';
            const faces    = [];
            const faceData = [];

            /* -- Shared hover info popup -- */
            let ppEl = document.getElementById('polaroidPopup');
            if (!ppEl) {
                ppEl = document.createElement('div');
                ppEl.id = 'polaroidPopup';
                ppEl.className = 'polaroid-popup';
                document.body.appendChild(ppEl);
                ppEl.addEventListener('mouseenter', () => clearTimeout(ppHideTimer));
                ppEl.addEventListener('mouseleave', () => ppEl.classList.remove('is-visible'));
            }
            let ppHideTimer;

            // esc() already available from the outer scope (window.Lightbox.esc)

            function showPopup(face, m) {
                if (!m) return;
                clearTimeout(ppHideTimer);
                let html = '<div class="pp-name">' + esc(m.name || m.username || '') + '</div>';
                if (m.pronouns) html += '<div class="pp-pronouns">' + esc(m.pronouns) + '</div>';
                if (m.isLive && m.twitchUsername) {
                    const thumb = 'https://static-cdn.jtvnw.net/previews-ttv/live_user_' + m.twitchUsername.toLowerCase() + '-440x248.jpg';
                    html += '<div class="pp-thumb-wrap"><img class="pp-thumb" src="' + thumb + '" alt="Live preview" loading="lazy"></div>';
                }
                if (m.twitch) {
                    const cls = m.isLive ? ' is-live' : '';
                    const lbl = m.isLive ? 'Live: Watch Now' : 'Twitch Channel';
                    html += '<a class="pp-twitch' + cls + '" href="' + esc(m.twitch) + '" target="_blank" rel="noopener noreferrer">' + lbl + '</a>';
                }
                if (!m.pronouns && !m.twitch) {
                    html += '<div class="pp-pronouns" style="opacity:0.6">No extra info</div>';
                }
                ppEl.innerHTML = html;
                const r = face.getBoundingClientRect();
                const isMobile = window.innerWidth < 600;
                if (isMobile) {
                    /* Position directly above the card */
                    const pw = Math.min(220, window.innerWidth - 16);
                    let lx = r.left + r.width / 2 - pw / 2;
                    lx = Math.max(8, Math.min(lx, window.innerWidth - pw - 8));
                    ppEl.style.width = pw + 'px';
                    ppEl.style.left = lx + 'px';
                    ppEl.style.top  = (r.top + window.scrollY) + 'px';
                    ppEl.style.transform = 'translateY(calc(-100% - 8px))';
                } else {
                    const gap = 10, pw = 200;
                    ppEl.style.width = '';
                    ppEl.style.transform = '';
                    let lx = r.right + gap;
                    let ty = r.top + r.height / 2 - 80;
                    if (lx + pw > window.innerWidth - 8) lx = r.left - pw - gap;
                    ty = Math.max(8, Math.min(ty, window.innerHeight - 280));
                    ppEl.style.left = lx + 'px';
                    ppEl.style.top  = ty + 'px';
                }
                ppEl.classList.add('is-visible');
            }

            function hidePopup() {
                ppHideTimer = setTimeout(() => ppEl.classList.remove('is-visible'), 100);
            }

            /* Click outside any face → dismiss popup */
            document.addEventListener('click', function(e) {
                if (ppEl.classList.contains('is-visible') && !e.target.closest('.skin-halo-face') && !e.target.closest('#polaroidPopup')) {
                    ppEl.classList.remove('is-visible');
                    ppEl._anchor = null;
                }
            });

            /* Scroll → dismiss popup (require real movement to avoid iOS micro-scroll on tap) */
            let _ppScrollY = window.scrollY;
            window.addEventListener('scroll', function() {
                if (Math.abs(window.scrollY - _ppScrollY) > 10 && ppEl.classList.contains('is-visible')) {
                    ppEl.classList.remove('is-visible');
                    ppEl._anchor = null;
                }
                _ppScrollY = window.scrollY;
            }, { passive: true });

            active.forEach((member, i) => {
                const face = document.createElement('div');
                face.className = 'skin-halo-face';

                const inner = document.createElement('div');
                inner.className = 'skin-halo-face-inner';

                const img = document.createElement('img');
                const safeName = encodeURIComponent(member.name || member.username || `Player${i + 1}`);
                img.src  = `https://minotar.net/helm/${safeName}/128`;
                img.alt  = `${member.name || member.username || 'TSNSMP member'}'s skin`;

                const label = document.createElement('span');
                label.textContent = member.name || member.username || 'New Member';

                /* static glint streak */
                const glint = document.createElement('div');
                glint.className = 'polaroid-glint';

                /* live dot badge if streaming */
                if (member.isLive) {
                    const liveDot = document.createElement('span');
                    liveDot.className = 'polaroid-live-dot';
                    inner.appendChild(liveDot);
                }

                inner.appendChild(img);
                inner.appendChild(label);
                inner.appendChild(glint);
                face.appendChild(inner);

                /* pin live members so they are never rotated out */
                if (member.isLive) {
                    face.classList.add('is-pinned');
                    face.dataset.pinned = 'true';
                }

                face._member = member;
                face.addEventListener('mouseenter', () => showPopup(face, face._member));
                face.addEventListener('mouseleave', hidePopup);
                /* Click/tap: live members on mobile open stream directly; otherwise toggle popup */
                face.addEventListener('click', function() {
                    const m = face._member;
                    if (window.innerWidth < 600 && m && m.isLive && m.twitch) {
                        window.open(m.twitch, '_blank', 'noopener,noreferrer');
                        return;
                    }
                    if (ppEl.classList.contains('is-visible') && ppEl._anchor === face) {
                        ppEl.classList.remove('is-visible');
                        ppEl._anchor = null;
                    } else {
                        ppEl._anchor = face;
                        showPopup(face, face._member);
                    }
                });

                ring.appendChild(face);
                faces.push(face);
                faceData.push(member);
            });

            if (reserve.length === 0) return;

            const EXIT_DIRS = ['left', 'right', 'up'];
            const ENTER_OPP = { left: 'right', right: 'left', up: 'down' };
            let swapping = false;

            function swapFace(slotIdx) {
                const rIdx      = Math.floor(Math.random() * reserve.length);
                const newMember = reserve.splice(rIdx, 1)[0];
                reserve.push(faceData[slotIdx]);
                faceData[slotIdx] = newMember;

                const face     = faces[slotIdx];
                const inner    = face.querySelector('.skin-halo-face-inner');
                const exitDir  = EXIT_DIRS[Math.floor(Math.random() * EXIT_DIRS.length)];
                const enterDir = ENTER_OPP[exitDir];

                inner.classList.add(`polaroid-exit-${exitDir}`);

                setTimeout(() => {
                    /* update content while card is off-screen */
                    const img      = face.querySelector('img');
                    const label    = face.querySelector('.skin-halo-face-inner > span');
                    const safeName = encodeURIComponent(newMember.name || newMember.username || 'Player');
                    if (label)   label.textContent = newMember.name || newMember.username || 'New Member';
                    face._member = newMember;
                    /* sync live dot */
                    const liveDot = inner.querySelector('.polaroid-live-dot');
                    if (newMember.isLive && !liveDot) {
                        const dot = document.createElement('span');
                        dot.className = 'polaroid-live-dot';
                        inner.appendChild(dot);
                    } else if (!newMember.isLive && liveDot) {
                        liveDot.remove();
                    }

                    function doEnter() {
                        inner.classList.remove(`polaroid-exit-${exitDir}`);
                        inner.classList.add(`polaroid-enter-${enterDir}`);
                        setTimeout(() => {
                            inner.classList.remove(`polaroid-enter-${enterDir}`);
                            swapping = false;
                        }, 500);
                    }

                    if (img) {
                        /* Preload the new skin; only slide in once it's ready */
                        const preload = new Image();
                        preload.onload  = () => { img.src = preload.src; img.alt = `${newMember.name || newMember.username || 'TSNSMP member'}'s skin`; doEnter(); };
                        preload.onerror = () => { img.src = preload.src; doEnter(); }; /* still swap on error */
                        preload.src = `https://minotar.net/helm/${safeName}/128`;
                    } else {
                        doEnter();
                    }
                }, 400);
            }

            setInterval(() => {
                if (swapping) return;
                /* only swap non-pinned (non-live) slots */
                const available = faces.map((_, i) => i).filter(i => faces[i].dataset.pinned !== 'true');
                if (!available.length) return;
                swapping = true;
                swapFace(available[Math.floor(Math.random() * available.length)]);
            }, 3600);
        }

        /* -- Hero Init: always show polaroids; pin live streamers first -- */
        (async function initHeroVisual() {
            const haloWrap   = document.getElementById('heroHaloWrap');
            const streamWrap = document.getElementById('heroStreamWrap');
            const ring       = document.getElementById('skinHalo');

            /* Always hide the stream embed panel - we use polaroid live badges instead */
            if (streamWrap) streamWrap.style.display = 'none';

            /* 1. Fetch members from Firebase ? fallback to JSON */
            let members = [];
            try {
                const snap = await get(ref(db, 'members'));
                const raw  = snap.val();
                members = raw ? (Array.isArray(raw) ? raw : Object.values(raw)) : [];
            } catch (e) { /* silent */ }

            if (!members.length) {
                try { members = await fetch('/data/members.json').then(r => r.json()); }
                catch (e) { /* silent */ }
            }

            if (!members.length) { buildSkinRing(ring, []); return; }

            /* 1b. Show live member count badge */
            const badge   = document.getElementById('heroMemberBadge');
            const countEl = document.getElementById('heroMemberCount');
            if (badge && countEl) {
                countEl.textContent = `${members.length} Members`;
                badge.style.removeProperty('display');
            }

            /* 2. Probe for live streams - mark each member.isLive */
            const liveStreams = await detectLiveStreams(members);
            const liveMap = new Map(liveStreams.map(s => [(s.name || s.username || '').toLowerCase(), s.twitchUsername || '']));
            members.forEach(m => {
                const key = (m.name || m.username || '').toLowerCase();
                m.isLive = liveMap.has(key);
                if (m.isLive) m.twitchUsername = liveMap.get(key);
                if (!m.twitchUsername && m.twitch) m.twitchUsername = extractTwitchUsername(m.twitch);
            });

            /* 3. Sort: live members first, then shuffle the rest */
            const live    = members.filter(m => m.isLive);
            const nonLive = members.filter(m => !m.isLive).sort(() => Math.random() - 0.5);
            const sorted  = [...live, ...nonLive];

            /* 4. Preload the first batch of skins concurrently so they hit cache
               before buildSkinRing touches the DOM. 3 s timeout = safety net. */
            const MAX_PRELOAD = Math.min(12, sorted.length);
            await Promise.race([
                Promise.all(sorted.slice(0, MAX_PRELOAD).map(m => new Promise(resolve => {
                    const url = `https://minotar.net/helm/${encodeURIComponent(m.name || m.username || 'Player')}/128`;
                    const pi  = new Image();
                    pi.onload = pi.onerror = resolve;
                    pi.src = url;
                }))),
                new Promise(resolve => setTimeout(resolve, 3000))
            ]);

            buildSkinRing(ring, sorted);
        })();

