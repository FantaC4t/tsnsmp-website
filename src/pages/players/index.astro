---
import Layout from '../../layouts/Layout.astro';
import '../../styles/players.css';
---

<Layout
    title="Our Community - TSNSMP"
    description="Meet the members of TSNSMP — our cozy, whitelisted Minecraft SMP community."
    path="/players/"
    ogTitle="Our Community - TSNSMP"
    currentPage="players"
>
<Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.tsnsmp.online/" },
        { "@type": "ListItem", "position": 2, "name": "Community", "item": "https://www.tsnsmp.online/players/" }
      ]
    })} />
</Fragment>

<main id="main-content">
    <section class="players-hero">
        <div class="hero-bg"></div>
        <div class="hero-grid"></div>
        <div class="container">
            <h1><span class="gradient-text" data-text="Meet the Community">Meet the Community</span></h1>
            <p class="players-hero-subtitle">
                The amazing people who make TSNSMP special.
            </p>

        </div>
    </section>

    <section class="players-list">
        <div class="container">
            <div class="players-search">
                <div class="players-search-note">
                    <label class="players-search-label" for="player-search">🔍 who are you looking for?</label>
                    <input type="text" id="player-search" placeholder="Type a name..." autocomplete="off" />
                </div>
            </div>
            <p class="players-missing-notice">
                👋 Member but not listed? DM <strong>Our Staff</strong> to be added — PLEASE include your <strong>color</strong>, <strong>pronouns</strong>, and <strong>Twitch link</strong> if you have one!
            </p>
            <p style="text-align:center;margin-top:.6rem">
                <a href="/admin/" style="font-size:.8rem;color:var(--text-secondary);opacity:.5;text-decoration:none;transition:opacity .2s" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=.5">🛠️ Admin</a>
            </p>
            <div class="players-grid" id="players-grid">
                <!-- Players will be injected here -->
            </div>
        </div>
    </section>
</main>

<script>
    // @ts-nocheck — plain JS, not TypeScript; this only opts out of the IDE/
    // astro-check type checking that comes for free once a script is a real
    // Vite-processed module (it was invisible to that while still living in
    // the unprocessed page-script slot).
    import { ref, onValue } from 'firebase/database';
    import { db } from '../../scripts/firebase-client.js';

    const grid = document.getElementById('players-grid');

    // ── 7UpPup glitch corruption ──
    const GLYPH_POOL = 'ÅŽŸ§±×÷ĦĴĿŊŪŭůűŲŵŷŹźżžſƀƃƄƈƊƋƎƏƢƣƤƦƧƩƪƫÐÞҒӁӂӃӇ';
    function randGlyph(len) {
        return Array.from({ length: len }, () =>
            GLYPH_POOL[Math.floor(Math.random() * GLYPH_POOL.length)]
        ).join('');
    }

    function startImposterCorruption(card) {
        const nameEl     = card.querySelector('.player-name');
        const pronounsEl = card.querySelector('.player-pronouns');
        const roleEl     = card.querySelector('.player-role');
        const realNameHTML = nameEl.innerHTML;
        const realPronouns = pronounsEl ? pronounsEl.textContent : '';
        const realRole     = roleEl     ? roleEl.textContent     : '';

        function corrupt() {
            card.classList.add('player-card--corrupted');
            nameEl.innerHTML = randGlyph(5 + Math.floor(Math.random() * 5));
            if (pronounsEl) pronounsEl.textContent = randGlyph(3) + '/' + randGlyph(3);
            if (roleEl)     roleEl.textContent     = randGlyph(6 + Math.floor(Math.random() * 4));
            setTimeout(restore, 1200 + Math.random() * 2000);
        }
        function restore() {
            card.classList.remove('player-card--corrupted');
            nameEl.innerHTML = realNameHTML;
            if (pronounsEl) pronounsEl.textContent = realPronouns;
            if (roleEl) { roleEl.textContent = realRole; roleEl.className = 'player-role role-imposter'; }
            setTimeout(corrupt, 3000 + Math.random() * 5000);
        }
        setTimeout(corrupt, 1500 + Math.random() * 3000);
    }

    // ── Render ──
    function buildCard(member) {
        const card = document.createElement('div');
        card.className = 'player-card';
        card.dataset.name = member.name.toLowerCase();
        if (member.name === '7UpPup') card.classList.add('player-card--glitch');

        const skinUrl = `https://minotar.net/armor/body/${member.name}/150.png`;

        const safeTwitch = typeof member.twitch === 'string' && member.twitch.startsWith('https://') ? member.twitch : null;
        const twitchIcon = safeTwitch ? `
            <a href="${safeTwitch}" target="_blank" rel="noopener noreferrer" class="twitch-link" title="Watch on Twitch">
                <svg class="twitch-icon-svg" viewBox="0 0 24 24">
                    <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/>
                </svg>
            </a>` : '';

        const safeColor = typeof member.color === 'string' && /^#[0-9a-fA-F]{3,8}$/.test(member.color) ? member.color : null;
        const nameStyle = safeColor ? `style="color: ${safeColor}"` : '';
        const nameClass = safeColor ? 'player-name' : 'player-name player-name--no-color';

        // Normalize role for display and class
        let role = (member.role || '').toLowerCase();
        if (role === 'owner') role = 'staff';
        if (role === 'mod' || role === 'admin') role = 'trialstaff';
        let roleLabel = role === 'trialstaff' ? 'Trial Staff' : (role === 'staff' ? 'Staff' : role.charAt(0).toUpperCase() + role.slice(1));
        card.innerHTML = `
            <div class="skin-viewer">
                <img src="${skinUrl}" alt="${member.name}" class="skin-image" loading="lazy"
                     onerror="this.src='https://minotar.net/armor/body/Steve/150.png'">
            </div>
            <div class="player-info">
                <div class="${nameClass}" ${nameStyle}>${member.name}</div>
                <div class="player-chips">
                    ${twitchIcon}
                    ${member.pronouns ? `<div class="player-pronouns">${member.pronouns}</div>` : ''}
                    <div class="player-role role-${role}">${roleLabel}</div>
                </div>
            </div>
        `;
        return card;
    }

    const ROLE_ORDER = ['staff', 'trialstaff', 'member', 'imposter'];

    function renderPlayers(members) {
        members = [...members].sort((a, b) => {
            let ar = (a.role || '').toLowerCase();
            let br = (b.role || '').toLowerCase();
            if (ar === 'owner') ar = 'staff';
            if (ar === 'mod' || ar === 'admin') ar = 'trialstaff';
            if (br === 'owner') br = 'staff';
            if (br === 'mod' || br === 'admin') br = 'trialstaff';
            const ai = ROLE_ORDER.indexOf(ar);
            const bi = ROLE_ORDER.indexOf(br);
            const av = ai === -1 ? ROLE_ORDER.length : ai;
            const bv = bi === -1 ? ROLE_ORDER.length : bi;
            return av - bv;
        });

        if (members.length === 0) {
            grid.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">Couldn\'t load members</p><p class="empty-state-desc">Please try again later.</p></div>';
            return;
        }

        grid.innerHTML = '';
        const searchTerm = document.getElementById('player-search').value.toLowerCase();

        for (const member of members) {
            const card = buildCard(member);
            grid.appendChild(card);
            if (member.name === '7UpPup') startImposterCorruption(card);
            if (searchTerm && !member.name.toLowerCase().includes(searchTerm)) {
                card.style.display = 'none';
            }
        }
    }

    // ── Real-time listener — re-renders whenever the DB changes ──
    grid.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">Loading members…</p></div>';

    onValue(ref(db, 'members'), snap => {
        const raw = snap.val();
        let members = raw ? (Array.isArray(raw) ? raw : Object.values(raw)) : [];

        if (members.length > 0) {
            renderPlayers(members);
        } else {
            // Fallback to members.json if Firebase returns nothing
            fetch('/data/members.json')
                .then(r => r.ok ? r.json() : [])
                .then(renderPlayers)
                .catch(e => {
                    console.error('Failed to load members.json fallback:', e);
                    grid.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">Couldn\'t load members</p><p class="empty-state-desc">Please try again later.</p></div>';
                });
        }
    }, e => {
        console.warn('Firebase unavailable, falling back to members.json:', e);
        fetch('/data/members.json')
            .then(r => r.ok ? r.json() : [])
            .then(renderPlayers)
            .catch(() => {
                grid.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">Couldn\'t load members</p><p class="empty-state-desc">Please try again later.</p></div>';
            });
    });

    document.getElementById('player-search').addEventListener('input', function () {
        const term = this.value.toLowerCase().trim();
        document.querySelectorAll('.player-card').forEach(card => {
            card.style.display = (!term || card.dataset.name.includes(term)) ? '' : 'none';
        });
    });
</script>
</Layout>
