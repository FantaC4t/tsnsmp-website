    <!-- ══ WORLD DOWNLOADS ══ -->
    <section id="downloads" class="resource-section">
        <div class="container">
            <div class="section-header">
                <h2>World Downloads</h2>
                <p class="section-subtitle">Download past world saves to explore on your own.</p>
            </div>
