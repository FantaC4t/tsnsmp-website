                </div>
            </div>
        </div>
    </section>
</main><!-- /resources-content -->

<script>
    // @ts-nocheck — plain JS, not TypeScript (see players/index.astro for context)
    import { ref, onValue } from 'firebase/database';
    import { db } from '../../scripts/firebase-client.js';

    /* ── Scroll-spy for nav highlights ── */
    const navLinks = document.querySelectorAll('.resource-tabs a');
    const sections = document.querySelectorAll('.resource-section');

    const scrollSpy = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                navLinks.forEach(a => a.classList.toggle('active', a.dataset.section === entry.target.id));
            }
        });
    }, { rootMargin: '-40% 0px -55% 0px' });

    sections.forEach(s => scrollSpy.observe(s));

    // Smooth-scroll on nav click
    navLinks.forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            const target = document.getElementById(a.dataset.section);
            if (target) {
                const navH = document.querySelector('.resources-nav').offsetHeight;
                const y = target.getBoundingClientRect().top + window.scrollY - navH - 12;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        });
    });

    /* ── World Downloads from Firebase ── */
    const DOWNLOADS_REF = ref(db, 'worldDownloads');

    onValue(DOWNLOADS_REF, snap => {
        const container = document.getElementById('downloads-grid');
        const data = snap.val();

        if (!data) {
            container.innerHTML = '<div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No downloads yet</p><p class="empty-state-desc">World downloads will show up here once available.</p></div>';
            return;
        }

        const entries = Object.values(data).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));

        container.innerHTML = entries.map(dl => `
            <a class="download-card" href="${dl.url}" target="_blank" rel="noopener noreferrer">
                <span class="download-icon">📥</span>
                <span class="download-title">${dl.title}</span>
                <span class="download-arrow">↗</span>
            </a>
        `).join('');
    });
</script>
</Layout>
