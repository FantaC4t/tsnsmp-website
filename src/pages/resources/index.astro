                <div class="empty-state"><img class="empty-state-icon" src="/assets/mascot.png" alt="" width="90" height="68" loading="lazy" /><p class="empty-state-title">No downloads yet</p><p class="empty-state-desc">World downloads will show up here once available.</p></div>
            </div>
        </div>
