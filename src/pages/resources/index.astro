---
import Layout from '../../layouts/Layout.astro';
import '../../styles/resources.css';
---

<Layout
    title="Resources - TSNSMP Server"
    description="TSNSMP resources — mods, datapacks, guides, and links for our Minecraft SMP community."
    path="/resources/"
    ogTitle="Resources - TSNSMP"
    currentPage="resources"
>
<Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://tsnsmp.com/" },
        { "@type": "ListItem", "position": 2, "name": "Resources", "item": "https://tsnsmp.com/resources/" }
      ]
    })} />
</Fragment>

<main id="main-content">
    <section class="page-hero">
        <div class="hero-bg"></div>
        <div class="hero-grid"></div>
        <div class="floating-shapes">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
        </div>

        <div class="container" style="position: relative; z-index: 2;">
            <div class="hero-content-resources">
                <h1><span class="gradient-text" data-text="Server Resources">Server Resources</span></h1>
                <p>Everything you need to know about playing on TSNSMP</p>
            </div>
        </div>
    </section>
</main>

<nav class="resources-nav">
    <div class="container">
        <div class="resource-tabs">
            <a class="tab-btn active" href="#rules" data-section="rules">📜 Rules</a>
            <a class="tab-btn" href="#icons" data-section="icons">🔰 Icons</a>
            <a class="tab-btn" href="#mods" data-section="mods">🧩 Mods &amp; Features</a>
            <a class="tab-btn" href="#downloads" data-section="downloads">📥 World Downloads</a>
            <a class="tab-btn" href="#map" data-section="map">🗺️ Live Map</a>
        </div>
    </div>
</nav>

<main id="resources-content">
    <!-- ══ RULES ══ -->
    <section id="rules" class="resource-section">
        <div class="container">
            <div class="section-header">
                <h2>Server Rules</h2>
                <p class="section-subtitle">Keep it chill. Keep it fun. Keep it respectful.</p>
            </div>
            <div class="rules-grid">
                <div class="rule-card">
                    <div class="rule-number">1</div>
                    <div class="rule-content">
                        <h3>English Only</h3>
                        <p>Please keep all chatting in Discord, Minecraft, and voice calls in English for the sake of our moderation team being able to do their job.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">2</div>
                    <div class="rule-content">
                        <h3>No Harassment of any kind</h3>
                        <p>Be respectful and kind to everyone. No derogatory or hateful speech — no racism, homophobia, xenophobia, sexism, misogyny, ableism, transphobia, or slurs. If someone tells you they are uncomfortable by your behavior, stop.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">3</div>
                    <div class="rule-content">
                        <h3>No Sharing of Sensitive Information</h3>
                        <p>This includes yourself and anyone else. Do not share addresses, locations, pictures, etc.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">4</div>
                    <div class="rule-content">
                        <h3>Be Mindful In-Game</h3>
                        <p>No hacking, cheating, griefing, or stealing. No killing without consent. Keep buildings and all in-game content friendly. Some folks stream.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">5</div>
                    <div class="rule-content">
                        <h3>If You See Something, Say Something</h3>
                        <p>If you see anyone breaking any rules, open a support ticket. This alerts staff that there is an issue and helps them take action. If you feel uncomfortable or want to suggest an improvement, open a ticket too.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">6</div>
                    <div class="rule-content">
                        <h3>No NSFW / NSFL Content</h3>
                        <p>No NSFW/NSFL, sexual, or lewd content of any kind.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">7</div>
                    <div class="rule-content">
                        <h3>Keep Sensitive Topics to a Minimum</h3>
                        <p>This means any political, inflammatory, or religious topics. Do not trauma dump or overshare.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">8</div>
                    <div class="rule-content">
                        <h3>No Spamming Members or Staff</h3>
                        <p>Do not mention people repeatedly, even if there is no response. If you need staff's attention and they don't respond, open a ticket so ALL of the staff can see and help.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">9</div>
                    <div class="rule-content">
                        <h3>Follow All Discord TOS</h3>
                        <p>All of Discord's Terms of Service still apply here.</p>
                    </div>
                </div>
                <div class="rule-card">
                    <div class="rule-number">10</div>
                    <div class="rule-content">
                        <h3>Use Common Sense</h3>
                        <p>Just because something isn't mentioned here doesn't mean it's allowed. It not being in the rules is no excuse for bad behavior.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ ICONS ══ -->
    <section id="icons" class="resource-section">
        <div class="container">
            <div class="section-header">
                <h2>Player Icons</h2>
                <p class="section-subtitle">These icons appear next to player names in-game — here's what they mean.</p>
            </div>
            <div class="icons-showcase">
                <div class="icon-card-v2">
                    <div class="icon-card-v2-visual">
                        <img src="/assets/icons/crown.png" alt="Admin Icon" width="32" height="32">
                    </div>
                    <div class="icon-card-v2-body">
                        <h3>Admin</h3>
                        <p>Server administrators who keep the server running.</p>
                    </div>
                </div>
                <div class="icon-card-v2">
                    <div class="icon-card-v2-visual">
                        <img src="/assets/icons/sparkles.png" alt="Staff Icon" width="32" height="32">
                    </div>
                    <div class="icon-card-v2-body">
                        <h3>Staff</h3>
                        <p>Moderators and Event Organizers who keep the server fun and safe.</p>
                    </div>
                </div>
                <div class="icon-card-v2">
                    <div class="icon-card-v2-visual">
                        <img src="/assets/icons/shareholder.png" alt="Shareholder Icon" width="32" height="32">
                    </div>
                    <div class="icon-card-v2-body">
                        <h3>Shareholder</h3>
                        <p>Paying members who help support the server hosting costs.</p>
                    </div>
                </div>
                <div class="icon-card-v2">
                    <div class="icon-card-v2-visual icon-card-v2-visual--live">
                        <img src="/assets/icons/LIVE.png" alt="Live Icon" class="icon-live" width="32" height="32">
                    </div>
                    <div class="icon-card-v2-body">
                        <h3>Live Now</h3>
                        <p>Indicates a player is currently streaming.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ MODS & FEATURES ══ -->
    <section id="mods" class="resource-section">
        <div class="container">
            <div class="section-header">
                <h2>Mods &amp; Features</h2>
                <p class="section-subtitle">Everything installed on the server — what it does and how to use it.</p>
            </div>

            <div class="mod-group">
                <div class="mod-group-header">
                    <span class="mod-group-icon">⭐</span>
                    <h3 class="mod-group-label">Custom Mods</h3>
                </div>
                <div class="mods-grid">
                    <div class="mod-card mod-card--custom">
                        <div class="mod-card-top">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/fantas-smart-placeholders" target="_blank" rel="noopener noreferrer">Fanta's Smart Placeholders</a>
                            <span class="mod-badge badge--custom">Custom</span>
                        </div>
                        <p class="mod-desc">A custom mod powering TSNSMP's player status system — live badges, name colors, profiles, lore, and more.</p>
                        <ul class="mod-cmds">
                            <li><code>/live</code> — Toggle your live status. <code>/live link &lt;url&gt;</code> sets your stream link (Twitch auto-detected). <code>/live list</code> shows who's currently live.</li>
                            <li><code>/color &lt;hex&gt;</code> — Color your name. <code>/color gradient &lt;hex1&gt; &lt;hex2&gt;</code> for a gradient.</li>
                            <li><code>/lore &lt;text&gt;</code> — Set a personal bio shown on your profile card.</li>
                            <li><code>/profile [player]</code> — View any player's full profile, even offline.</li>
                            <li><code>/nosleep</code> — Block others from sleeping while you're active.</li>
                            <li><code>/features</code> — Browse all commands and placeholders.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mod-group">
                <div class="mod-group-header">
                    <span class="mod-group-icon">🔧</span>
                    <h3 class="mod-group-label">Quality of Life</h3>
                </div>
                <div class="mods-grid">
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/SRlzjEBS/9525c545236accda2b3724df7bf8ffe9025112f0.png" alt="AudioPlayer mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/audioplayer" target="_blank" rel="noopener noreferrer">AudioPlayer</a>
                        </div>
                        <p class="mod-desc">Put custom sounds on discs, goat horns and note blocks.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/BITzwT7B/6be9d25207fe2406711546020b48b40980c40f6_96.webp" alt="ClickVillagers mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/plugin/clickvillagers" target="_blank" rel="noopener noreferrer">ClickVillagers</a>
                        </div>
                        <p class="mod-desc">Shift + right-click a villager to pick it up. Place it back by placing the villager head — works in boats and minecarts too.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/625eK1Si/139ec4d54a8b33afcc465dbc29232a473feead0_96.webp" alt="Kiss Mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/kiss-fabric" target="_blank" rel="noopener noreferrer">Kiss Mod</a>
                        </div>
                        <p class="mod-desc">Kiss another player.</p>
                        <ul class="mod-cmds"><li><code>/kiss &lt;player&gt;</code></li></ul>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/yn9u3ypm/a933032aa191fdc43cd439074f5713f8351e7af9.png" alt="Graves mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/universal-graves" target="_blank" rel="noopener noreferrer">Graves</a>
                        </div>
                        <p class="mod-desc">A grave spawns where you die, keeping your items safe.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/1LE7mid6/226891eaa12906cef67bf671eb2204cb3e7a7b22.png" alt="Instant Groups mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/enhanced-groups" target="_blank" rel="noopener noreferrer">Instant Groups</a>
                        </div>
                        <p class="mod-desc">Pull everyone nearby into a Simple Voice Chat open group instantly.</p>
                        <ul class="mod-cmds"><li><code>/instantgroup &lt;range&gt;</code></li></ul>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/13RpG7dA/501cb456e7a651d84b489047ed51aa42234b14b9_96.webp" alt="Image2Map mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/image2map" target="_blank" rel="noopener noreferrer">Image2Map</a>
                        </div>
                        <p class="mod-desc">Render any image onto maps. Each map is 128×128 px. The URL must point directly to an image file.</p>
                        <ul class="mod-cmds"><li><code>/image2map create &lt;W&gt; &lt;H&gt; &lt;dither/none&gt; &lt;url&gt;</code></li></ul>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/kTwcC3jx/77b4973aee3988249d181a7b98f17a7c8f35ced.png" alt="RealHeight mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/oszoukauas-real-height" target="_blank" rel="noopener noreferrer">RealHeight</a>
                        </div>
                        <p class="mod-desc">Change your player height. Limited to 1.2 – 2.2 blocks.</p>
                        <ul class="mod-cmds"><li><code>/trigger height_menu</code></li></ul>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/TnOXNf5e/d8a161534812378a69d5b6d7b7393998a6d1f44.png" alt="Peek mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/peek" target="_blank" rel="noopener noreferrer">Peek</a>
                            <span class="mod-badge badge--client">Client mod needed</span>
                        </div>
                        <p class="mod-desc">Shows an item preview on shulker boxes without opening them.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/EXzIPtJo/b9984c91f53225fb1f7167593942d85fe2b0b45e_96.webp" alt="Replanting Crops mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/replanting-crops" target="_blank" rel="noopener noreferrer">Replanting Crops</a>
                        </div>
                        <p class="mod-desc">Break crops with a hoe and they replant themselves automatically.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/DuUMFIfX/d8a4745dbaf7525dcea2c00dccdd557f3b26e70_96.webp" alt="MasterCutter mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/mastercutter" target="_blank" rel="noopener noreferrer">MasterCutter</a>
                        </div>
                        <p class="mod-desc">500+ new stonecutter recipes — woodcutting, stripping, recycling and more.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/formatname" target="_blank" rel="noopener noreferrer">FormatName</a>
                        </div>
                        <p class="mod-desc">Tweak name colors and add effects to your items.</p>
                        <ul class="mod-cmds"><li><code>/trigger FormatName</code></li></ul>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/ncsAPvAb/11fd4aa1a66094826b131ece789bce856cd6c1d_96.webp" alt="NoWeatherSkip mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/noweatherskip" target="_blank" rel="noopener noreferrer">NoWeatherSkip</a>
                        </div>
                        <p class="mod-desc">Sleeping no longer skips rain/thunder — weather plays out naturally.</p>
                    </div>
                </div>
            </div>

            <div class="mod-group">
                <div class="mod-group-header">
                    <span class="mod-group-icon">🏗️</span>
                    <h3 class="mod-group-label">Decoration &amp; Building</h3>
                </div>
                <div class="mods-grid">
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/l6VVh2KR/b7db183ddfb1812dbc4b20058204ef66cfd928c.png" alt="Better Hanging Signs mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/better-hanging-signs" target="_blank" rel="noopener noreferrer">Better Hanging Signs</a>
                        </div>
                        <p class="mod-desc">Place item frames on hanging signs to display items on them.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/bbGCtEvb/005eb8a0a3b751e6a595757743a7032353776f44_96.webp" alt="Armor Statues mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/mod/armor-statues" target="_blank" rel="noopener noreferrer">Armor Statues</a>
                        </div>
                        <p class="mod-desc">Full armor stand customization via a signed book named "Statues".</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/zJIYJfn8/290af39b71a85c4e90ea0ba98e52bb4753316b9b_96.webp" alt="Catenary mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/catenary" target="_blank" rel="noopener noreferrer">Catenary</a>
                        </div>
                        <p class="mod-desc">Add hanging chain/rope decorations between two points. Also works as a rideable zipline.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <span class="mod-name">Painting Picker</span>
                        </div>
                        <p class="mod-desc">Choose exactly which painting you want using the stonecutter.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/wN3RC3Zr/d78a566d53c274b83b1407dc2adb1b8abe684e6_96.webp" alt="Rope Ladders mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/gm4-rope-ladders" target="_blank" rel="noopener noreferrer">Rope Ladders</a>
                        </div>
                        <p class="mod-desc">Craft and hang rope ladders that dangle downward.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/K5IRddrD/18a1bc4b28d8a3a154160db75a3d6a72868a9fe4.png" alt="Invisible Frames mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/invisible-frames" target="_blank" rel="noopener noreferrer">Invisible Frames</a>
                        </div>
                        <p class="mod-desc">Toggle item frame visibility with Crouch + Right-click.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/cCStmVIN/9684ec94b146503cb4ab0210b367cbb313c68da_96.webp" alt="Banner Flags mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/banner-flags" target="_blank" rel="noopener noreferrer">Banner Flags</a>
                        </div>
                        <p class="mod-desc">Convert banners into decorative flags.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/pcN1B3cK/a56e9fdafce9068aaf042f0720a0eaba8629278_96.webp" alt="Banner Bedsheets mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/banner-bedsheet" target="_blank" rel="noopener noreferrer">Banner Bedsheets</a>
                        </div>
                        <p class="mod-desc">Convert banners into bedsheets.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/cPfmk5E3/9234e8723d1a1b2e4b2e4e4337b4d93b03ce7bcf.jpeg" alt="Gardener's Dream mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/gardeners-dream" target="_blank" rel="noopener noreferrer">Gardener's Dream</a>
                        </div>
                        <p class="mod-desc">Extra decoration options for flower pots and decorative pots.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/silk-touch-budding-amethyst" target="_blank" rel="noopener noreferrer">Silk Touch Budding Amethyst</a>
                        </div>
                        <p class="mod-desc">Mine budding amethyst with Silk Touch to keep it intact.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/cauldron-concrete-and-mud" target="_blank" rel="noopener noreferrer">Cauldron Concrete &amp; Mud</a>
                        </div>
                        <p class="mod-desc">Drop dirt or concrete powder into a water cauldron to get mud or wet concrete powder.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/craftable-vegan-ink" target="_blank" rel="noopener noreferrer">Craftable Vegan Ink</a>
                        </div>
                        <p class="mod-desc">Several crafting recipes for black dye that don't require ink sacs.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/5kEBpFCd/cdd28855e2d83869beb8e32ff45e8ac2e719ed02.png" alt="MC Paint mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/mc-paint" target="_blank" rel="noopener noreferrer">MC Paint</a>
                        </div>
                        <p class="mod-desc">Create custom paintings in-game using a Studio block. Export them as placeable Custom Paintings — works on floors and ceilings too.</p>
                    </div>
                </div>
            </div>

            <div class="mod-group">
                <div class="mod-group-header">
                    <span class="mod-group-icon">🐦</span>
                    <h3 class="mod-group-label">Mobs &amp; Creatures</h3>
                </div>
                <div class="mods-grid">
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/RTBZXjdc/d2751566d9dcd9bfe41cfaba0f8642df15756d9_96.webp" alt="Swift Ghasts mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/swift-ghasts" target="_blank" rel="noopener noreferrer">Swift Ghasts</a>
                        </div>
                        <p class="mod-desc">Upgrade a ghast harness in a smithing table (harness + netherite upgrade template + wind charge) to make it faster.</p>
                    </div>
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/LnG7iWcI/c152d1ba0eececfc052344cef4cdb03956856ef6_96.webp" alt="Happy Ghast Stopper mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/happy-ghast-stopper" target="_blank" rel="noopener noreferrer">Happy Ghast Stopper</a>
                        </div>
                        <p class="mod-desc">Rename a harness to <code>STOP</code> (case-sensitive) and equip it on a Happy Ghast to stop it from wandering.</p>
                    </div>
                </div>
            </div>

            <div class="mod-group">
                <div class="mod-group-header">
                    <span class="mod-group-icon">✨</span>
                    <h3 class="mod-group-label">Enchantments</h3>
                </div>
                <div class="mods-grid">
                    <div class="mod-card">
                        <div class="mod-card-top">
                            <img class="mod-icon" src="https://cdn.modrinth.com/data/OhduvhIc/f9c333a18b2c11a5fb063de8e86db8b76094c66.png" alt="Veinminer mod icon" loading="lazy">
                            <a class="mod-name mod-link" href="https://modrinth.com/datapack/ly-veinminer-enchantment" target="_blank" rel="noopener noreferrer">Veinminer</a>
                            <span class="mod-badge badge--optional">Optional</span>
