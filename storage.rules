rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Approved gallery images (read by everyone, write by admins only) ──
    match /gallery/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // ── Submission queue (anyone can submit + read URL, only admins can delete) ──
    match /gallery_queue/{allPaths=**} {
      allow read;
      allow delete: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

  }
}
